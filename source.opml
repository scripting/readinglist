	<body>
		<outline text="/scripting.com/code/feedland/apps/readinglist/" created="Sun, 02 Aug 2026 17:04:10 GMT">
			<outline text="worknotes.md" created="Sun, 02 Aug 2026 17:05:05 GMT">
				<outline text="#### 8/2/26; 1:05:13 PM by DW" created="Sun, 02 Aug 2026 17:05:08 GMT">
					<outline text="Started." created="Sun, 02 Aug 2026 17:05:14 GMT"/>
					</outline>
				</outline>
			<outline text="package.json">
				<outline text="{">
					<outline text="&quot;name&quot;: &quot;readinglist&quot;,"/>
					<outline text="&quot;description&quot;: &quot;Follow OPML reading lists in a feed reader -- reads a list, diffs against last time, tells your app what changed.&quot;,"/>
					<outline text="&quot;author&quot;: &quot;Dave Winer &lt;dave@scripting.com&gt;&quot;,"/>
					<outline text="&quot;version&quot;: &quot;0.4.0&quot;,"/>
					<outline text="&quot;main&quot;: &quot;readinglist.js&quot;,"/>
					<outline text="&quot;license&quot;: &quot;MIT&quot;,"/>
					<outline text="&quot;dependencies&quot;: {">
						<outline text="&quot;opml&quot;: &quot;0.5.8&quot;"/>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				</outline>
			<outline text="readinglist.js">
				<outline text="const myVersion = &quot;0.4.0&quot;, myProductName = &quot;readinglist&quot;; " created="Mon, 03 Feb 2014 03:21:03 GMT" pgfnum="36831"/>
				<outline text="" created="Sun, 02 Aug 2026 17:38:01 GMT"/>
				<outline text="exports.readingListManager = readingListManager;"/>
				<outline text="" created="Sun, 02 Aug 2026 17:19:07 GMT"/>
				<outline text="const https = require (&quot;https&quot;);"/>
				<outline text="const http = require (&quot;http&quot;);"/>
				<outline text="const opml = require (&quot;opml&quot;);"/>
				<outline text=""/>
				<outline text="function readingListManager (userOptions) {">
					<outline text="var options = {">
						<outline text="isSubscribed: function (feedUrl, callback) { //asks the app: already subscribed? callback (flSubscribed)">
							<outline text="callback (false);"/>
							<outline text="},"/>
							</outline>
						<outline text="subscribe: function (feedUrl, listInfo, callback) { //the app makes the subscription. callback (err)">
							<outline text="callback ();"/>
							<outline text="},"/>
							</outline>
						<outline text="unsubscribe: function (feedUrl, callback) { //the app removes it. callback (err)">
							<outline text="callback ();"/>
							<outline text="},"/>
							</outline>
						<outline text="loadState: function (callback) { //callback (err, theState) -- undefined the first time ever">
							<outline text="callback (undefined, undefined);"/>
							<outline text="},"/>
							</outline>
						<outline text="saveState: function (theState, callback) { //theState is a plain object, safe to stringify">
							<outline text="callback ();"/>
							<outline text="},"/>
							</outline>
						<outline text="userAgent: &quot;readinglist for node&quot;"/>
						<outline text="};"/>
						</outline>
					<outline text="for (var x in userOptions) {">
						<outline text="options [x] = userOptions [x];"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="var theState; //assigned by start -- {lists: {opmlUrl: listRec}, personalFeeds: {feedUrl: true}}"/>
					<outline text=""/>
					<outline text="function readUrl (theUrl, condGetInfo, callback) { //callback (err, {flNotModified} or {filetext, etag, lastModified})">
						<outline text="var theParsed;"/>
						<outline text="try {">
							<outline text="theParsed = new URL (theUrl);"/>
							<outline text="}"/>
							</outline>
						<outline text="catch (err) {">
							<outline text="const message = &quot;Can't read &quot; + theUrl + &quot; because it isn't a valid address.&quot;;"/>
							<outline text="callback ({message});"/>
							<outline text="return;"/>
							<outline text="}"/>
							</outline>
						<outline text="const theProtocol = (theParsed.protocol === &quot;http:&quot;) ? http : https;"/>
						<outline text="const theHeaders = {">
							<outline text="&quot;User-Agent&quot;: options.userAgent"/>
							<outline text="};"/>
							</outline>
						<outline text="if (condGetInfo.etag !== undefined) {">
							<outline text="theHeaders [&quot;If-None-Match&quot;] = condGetInfo.etag;"/>
							<outline text="}"/>
							</outline>
						<outline text="if (condGetInfo.lastModified !== undefined) {">
							<outline text="theHeaders [&quot;If-Modified-Since&quot;] = condGetInfo.lastModified;"/>
							<outline text="}"/>
							</outline>
						<outline text="const theRequest = theProtocol.get (theUrl, {headers: theHeaders}, function (theResponse) {">
							<outline text="if (theResponse.statusCode === 304) { //the list hasn't changed since last time">
								<outline text="theResponse.resume ();"/>
								<outline text="callback (undefined, {flNotModified: true});"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if ((theResponse.statusCode &gt;= 301) &amp;&amp; (theResponse.statusCode &lt;= 308)) { //follow a redirect">
									<outline text="theResponse.resume ();"/>
									<outline text="const theLocation = theResponse.headers.location;"/>
									<outline text="if ((theLocation === undefined) || (condGetInfo.ctRedirects &gt;= 5)) {">
										<outline text="const message = &quot;Can't read &quot; + theUrl + &quot; because the redirect couldn't be followed.&quot;;"/>
										<outline text="callback ({message});"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="const nextCondGetInfo = {">
											<outline text="etag: condGetInfo.etag,"/>
											<outline text="lastModified: condGetInfo.lastModified,"/>
											<outline text="ctRedirects: (condGetInfo.ctRedirects === undefined) ? 1 : condGetInfo.ctRedirects + 1"/>
											<outline text="};"/>
											</outline>
										<outline text="readUrl (new URL (theLocation, theUrl).toString (), nextCondGetInfo, callback);"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (theResponse.statusCode !== 200) {">
										<outline text="theResponse.resume ();"/>
										<outline text="const message = &quot;Can't read &quot; + theUrl + &quot; because the server answered with a &quot; + theResponse.statusCode + &quot;.&quot;;"/>
										<outline text="callback ({message});"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="var filetext = &quot;&quot;;"/>
										<outline text="theResponse.setEncoding (&quot;utf8&quot;);"/>
										<outline text="theResponse.on (&quot;data&quot;, function (theChunk) {">
											<outline text="filetext += theChunk;"/>
											<outline text="});"/>
											</outline>
										<outline text="theResponse.on (&quot;end&quot;, function () {">
											<outline text="callback (undefined, {">
												<outline text="filetext,"/>
												<outline text="etag: theResponse.headers [&quot;etag&quot;],"/>
												<outline text="lastModified: theResponse.headers [&quot;last-modified&quot;]"/>
												<outline text="});"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="theRequest.on (&quot;error&quot;, function (err) {">
							<outline text="const message = &quot;Can't read &quot; + theUrl + &quot; because &quot; + err.message + &quot;.&quot;;"/>
							<outline text="callback ({message});"/>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function isComment (theNode) { //comment nodes and everything under them are invisible">
						<outline text="return ((theNode.isComment === &quot;true&quot;) || (theNode.isComment === true));"/>
						<outline text="}"/>
						</outline>
					<outline text="function readList (opmlUrl, condGetInfo, callback) { //callback (err, {flNotModified} or {title, description, feeds, etag, lastModified})">
						<outline text="readUrl (opmlUrl, condGetInfo, function (err, theResult) {">
							<outline text="if (err) {">
								<outline text="callback (err);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if (theResult.flNotModified) {">
									<outline text="callback (undefined, theResult);"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="opml.parse (theResult.filetext, function (err, theOutline) {">
										<outline text="if (err) {">
											<outline text="const message = &quot;Can't understand the list at &quot; + opmlUrl + &quot; because it isn't valid OPML.&quot;;"/>
											<outline text="callback ({message});"/>
											<outline text="}"/>
											</outline>
										<outline text="else {">
											<outline text="var title, description;"/>
											<outline text="if (theOutline.opml.head !== undefined) { //a list with no head section is still a list">
												<outline text="title = theOutline.opml.head.title;"/>
												<outline text="description = theOutline.opml.head.description;"/>
												<outline text="}"/>
												</outline>
											<outline text="const theFeeds = [];"/>
											<outline text="opml.visitAll (theOutline, function (theNode) {">
												<outline text="if (!isComment (theNode)) {">
													<outline text="if (theNode.type === &quot;rss&quot;) {">
														<outline text="if (theNode.xmlUrl !== undefined) {">
															<outline text="theFeeds.push ({">
																<outline text="feedUrl: theNode.xmlUrl,"/>
																<outline text="text: theNode.text,"/>
																<outline text="htmlUrl: theNode.htmlUrl,"/>
																<outline text="categories: theNode.category"/>
																<outline text="});"/>
																</outline>
															<outline text="}"/>
															</outline>
														<outline text="}"/>
														</outline>
													<outline text="}"/>
													</outline>
												<outline text="return (true); //keep visiting"/>
												<outline text="});"/>
												</outline>
											<outline text="callback (undefined, {">
												<outline text="title, description,"/>
												<outline text="feeds: theFeeds,"/>
												<outline text="etag: theResult.etag,"/>
												<outline text="lastModified: theResult.lastModified"/>
												<outline text="});"/>
												</outline>
											<outline text="}"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function ctOtherProviders (feedUrl, opmlUrlToSkip) { //how many OTHER followed lists carry this feed">
						<outline text="var ct = 0;"/>
						<outline text="Object.keys (theState.lists).forEach (function (theListUrl) {">
							<outline text="if (theListUrl !== opmlUrlToSkip) {">
								<outline text="theState.lists [theListUrl].feedUrls.forEach (function (theFeedUrl) {">
									<outline text="if (theFeedUrl === feedUrl) {">
										<outline text="ct++;"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (ct);"/>
						<outline text="}"/>
						</outline>
					<outline text="function saveTheState (callback) {">
						<outline text="options.saveState (theState, function (err) {">
							<outline text="callback (err);"/>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function subscribeOnBehalfOfList (theFeeds, opmlUrl, callback) { //callback (err, ctSubscribed)"/>
					<outline text="">
						<outline text="/*  One feed at a time, in the order the list gives them. A feed">
							<outline text="another followed list already carries needs nothing. A feed the"/>
							<outline text="user already subscribes to personally is remembered as personal,"/>
							<outline text="so the list never owns it. Everything else gets subscribed.  */"/>
							</outline>
						<outline text=""/>
						<outline text="var ctSubscribed = 0;"/>
						<outline text="function doNextFeed (ix) {">
							<outline text="if (ix &lt; theFeeds.length) {">
								<outline text="const theFeed = theFeeds [ix];"/>
								<outline text="if (ctOtherProviders (theFeed.feedUrl, opmlUrl) &gt; 0) {">
									<outline text="doNextFeed (ix + 1);"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="options.isSubscribed (theFeed.feedUrl, function (flSubscribed) {">
										<outline text="if (flSubscribed) {">
											<outline text="theState.personalFeeds [theFeed.feedUrl] = true;"/>
											<outline text="doNextFeed (ix + 1);"/>
											<outline text="}"/>
											</outline>
										<outline text="else {">
											<outline text="const listInfo = {">
												<outline text="listUrl: opmlUrl,"/>
												<outline text="text: theFeed.text,"/>
												<outline text="htmlUrl: theFeed.htmlUrl,"/>
												<outline text="categories: theFeed.categories"/>
												<outline text="};"/>
												</outline>
											<outline text="options.subscribe (theFeed.feedUrl, listInfo, function (err) {">
												<outline text="if (err === undefined) {">
													<outline text="ctSubscribed++;"/>
													<outline text="}"/>
													</outline>
												<outline text="doNextFeed (ix + 1); //one feed failing doesn't stop the list"/>
												<outline text="});"/>
												</outline>
											<outline text="}"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="callback (undefined, ctSubscribed);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="doNextFeed (0);"/>
						<outline text="}"/>
						</outline>
					<outline text="function unsubscribeOnBehalfOfList (theFeedUrls, opmlUrl, callback) { //callback (err, ctUnsubscribed)"/>
					<outline text="">
						<outline text="/*  The provenance rule lives here: a feed survives if another">
							<outline text="followed list still carries it, or if it was the user's own"/>
							<outline text="before any list brought it around.  */"/>
							</outline>
						<outline text=""/>
						<outline text="var ctUnsubscribed = 0;"/>
						<outline text="function doNextFeed (ix) {">
							<outline text="if (ix &lt; theFeedUrls.length) {">
								<outline text="const theFeedUrl = theFeedUrls [ix];"/>
								<outline text="if (ctOtherProviders (theFeedUrl, opmlUrl) &gt; 0) {">
									<outline text="doNextFeed (ix + 1);"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (theState.personalFeeds [theFeedUrl]) {">
										<outline text="delete theState.personalFeeds [theFeedUrl]; //no list involves it anymore -- it's simply the user's"/>
										<outline text="doNextFeed (ix + 1);"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="options.unsubscribe (theFeedUrl, function (err) {">
											<outline text="if (err === undefined) {">
												<outline text="ctUnsubscribed++;"/>
												<outline text="}"/>
												</outline>
											<outline text="doNextFeed (ix + 1);"/>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="callback (undefined, ctUnsubscribed);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="doNextFeed (0);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function start (callback) { //read the saved state before anything else runs. callback (err)">
						<outline text="options.loadState (function (err, savedState) {">
							<outline text="if (err) {">
								<outline text="callback (err);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if (savedState === undefined) {">
									<outline text="theState = {">
										<outline text="lists: {},"/>
										<outline text="personalFeeds: {}"/>
										<outline text="};"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="theState = savedState;"/>
									<outline text="}"/>
									</outline>
								<outline text="callback ();"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function followList (opmlUrl, callback) { //callback (err, listRec)">
						<outline text="if (theState.lists [opmlUrl] !== undefined) { //already following -- nothing to do">
							<outline text="callback (undefined, theState.lists [opmlUrl]);"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="readList (opmlUrl, {}, function (err, theList) {">
								<outline text="if (err) {">
									<outline text="callback (err);"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="subscribeOnBehalfOfList (theList.feeds, opmlUrl, function (err, ctSubscribed) {">
										<outline text="const theFeedUrls = [];"/>
										<outline text="theList.feeds.forEach (function (theFeed) {">
											<outline text="theFeedUrls.push (theFeed.feedUrl);"/>
											<outline text="});"/>
											</outline>
										<outline text="const listRec = {">
											<outline text="opmlUrl,"/>
											<outline text="title: theList.title,"/>
											<outline text="description: theList.description,"/>
											<outline text="feedUrls: theFeedUrls,"/>
											<outline text="whenFollowed: new Date ().toISOString (),"/>
											<outline text="whenChecked: new Date ().toISOString (),"/>
											<outline text="etag: theList.etag,"/>
											<outline text="lastModified: theList.lastModified"/>
											<outline text="};"/>
											</outline>
										<outline text="theState.lists [opmlUrl] = listRec;"/>
										<outline text="saveTheState (function (err) {">
											<outline text="callback (err, listRec);"/>
											<outline text="});"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function unfollowList (opmlUrl, callback) { //callback (err)">
						<outline text="const listRec = theState.lists [opmlUrl];"/>
						<outline text="if (listRec === undefined) {">
							<outline text="const message = &quot;Can't unfollow &quot; + opmlUrl + &quot; because you're not following it.&quot;;"/>
							<outline text="callback ({message});"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="delete theState.lists [opmlUrl]; //out of the state first, so the provenance counts don't see it"/>
							<outline text="unsubscribeOnBehalfOfList (listRec.feedUrls, opmlUrl, function (err, ctUnsubscribed) {">
								<outline text="saveTheState (function (err) {">
									<outline text="callback (err);"/>
									<outline text="});"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function checkList (opmlUrl, callback) { //callback (err, {flUnchanged, adds, removes})">
						<outline text="const listRec = theState.lists [opmlUrl];"/>
						<outline text="if (listRec === undefined) {">
							<outline text="const message = &quot;Can't check &quot; + opmlUrl + &quot; because you're not following it.&quot;;"/>
							<outline text="callback ({message});"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="const condGetInfo = {">
								<outline text="etag: listRec.etag,"/>
								<outline text="lastModified: listRec.lastModified"/>
								<outline text="};"/>
								</outline>
							<outline text="readList (opmlUrl, condGetInfo, function (err, theList) {">
								<outline text="if (err) {">
									<outline text="callback (err); //an unreachable list changes nothing -- can't reach isn't the same as isn't there"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (theList.flNotModified) {">
										<outline text="listRec.whenChecked = new Date ().toISOString ();"/>
										<outline text="saveTheState (function (err) {">
											<outline text="callback (err, {flUnchanged: true, adds: [], removes: []});"/>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="const oldFeedUrls = listRec.feedUrls;"/>
										<outline text="const newFeedUrls = [];"/>
										<outline text="theList.feeds.forEach (function (theFeed) {">
											<outline text="newFeedUrls.push (theFeed.feedUrl);"/>
											<outline text="});"/>
											</outline>
										<outline text=""/>
										<outline text="function isInArray (theValue, theArray) {">
											<outline text="var flFound = false;"/>
											<outline text="theArray.forEach (function (theItem) {">
												<outline text="if (theItem === theValue) {">
													<outline text="flFound = true;"/>
													<outline text="}"/>
													</outline>
												<outline text="});"/>
												</outline>
											<outline text="return (flFound);"/>
											<outline text="}"/>
											</outline>
										<outline text="const addedFeeds = [], removedFeedUrls = [];"/>
										<outline text="theList.feeds.forEach (function (theFeed) {">
											<outline text="if (!isInArray (theFeed.feedUrl, oldFeedUrls)) {">
												<outline text="addedFeeds.push (theFeed);"/>
												<outline text="}"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="oldFeedUrls.forEach (function (theFeedUrl) {">
											<outline text="if (!isInArray (theFeedUrl, newFeedUrls)) {">
												<outline text="removedFeedUrls.push (theFeedUrl);"/>
												<outline text="}"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text=""/>
										<outline text="listRec.feedUrls = newFeedUrls; //the new truth, before the callbacks run"/>
										<outline text="listRec.title = theList.title;"/>
										<outline text="listRec.description = theList.description;"/>
										<outline text="listRec.etag = theList.etag;"/>
										<outline text="listRec.lastModified = theList.lastModified;"/>
										<outline text="listRec.whenChecked = new Date ().toISOString ();"/>
										<outline text=""/>
										<outline text="subscribeOnBehalfOfList (addedFeeds, opmlUrl, function (err, ctSubscribed) {">
											<outline text="unsubscribeOnBehalfOfList (removedFeedUrls, opmlUrl, function (err, ctUnsubscribed) {">
												<outline text="saveTheState (function (err) {">
													<outline text="const addedFeedUrls = [];"/>
													<outline text="addedFeeds.forEach (function (theFeed) {">
														<outline text="addedFeedUrls.push (theFeed.feedUrl);"/>
														<outline text="});"/>
														</outline>
													<outline text="callback (err, {flUnchanged: false, adds: addedFeedUrls, removes: removedFeedUrls});"/>
													<outline text="});"/>
													</outline>
												<outline text="});"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function checkLists (callback) { //every followed list, one at a time. callback (err, reports)">
						<outline text="const theListUrls = Object.keys (theState.lists);"/>
						<outline text="const theReports = [];"/>
						<outline text="function doNextList (ix) {">
							<outline text="if (ix &lt; theListUrls.length) {">
								<outline text="const opmlUrl = theListUrls [ix];"/>
								<outline text="checkList (opmlUrl, function (err, theChanges) {">
									<outline text="if (err) {">
										<outline text="theReports.push ({opmlUrl, error: err.message});"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="theReports.push ({opmlUrl, adds: theChanges.adds, removes: theChanges.removes, flUnchanged: theChanges.flUnchanged});"/>
										<outline text="}"/>
										</outline>
									<outline text="doNextList (ix + 1); //one list failing doesn't stop the others"/>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="callback (undefined, theReports);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="doNextList (0);"/>
						<outline text="}"/>
						</outline>
					<outline text="function getLists (callback) { //callback (err, array of listRecs)">
						<outline text="const theLists = [];"/>
						<outline text="Object.keys (theState.lists).forEach (function (opmlUrl) {">
							<outline text="theLists.push (theState.lists [opmlUrl]);"/>
							<outline text="});"/>
							</outline>
						<outline text="callback (undefined, theLists);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="this.start = start;"/>
					<outline text="this.followList = followList;"/>
					<outline text="this.unfollowList = unfollowList;"/>
					<outline text="this.checkList = checkList;"/>
					<outline text="this.checkLists = checkLists;"/>
					<outline text="this.getLists = getLists;"/>
					<outline text="}"/>
					</outline>
				</outline>
			<outline text="test.js">
				<outline text="/*  Tests for readinglist.js. 7/31/26 by CC"/>
				<outline text="">
					<outline text="A little http server plays the role of the web, serving OPML we control"/>
					<outline text="and honoring etags. A fake reader app records every subscribe and"/>
					<outline text="unsubscribe. Then we walk the contract, rule by rule."/>
					<outline text=""/>
					<outline text="Run it: node test.js -- it prints one line per test and a total.  */"/>
					</outline>
				<outline text=""/>
				<outline text="const http = require (&quot;http&quot;);"/>
				<outline text="const readinglist = require (&quot;../code/readinglist.js&quot;);"/>
				<outline text=""/>
				<outline text="const testPort = 1799;"/>
				<outline text="const urlServer = &quot;http://localhost:&quot; + testPort + &quot;/&quot;;"/>
				<outline text=""/>
				<outline text="var ctTests = 0, ctFailures = 0;"/>
				<outline text="function assert (flCondition, theMessage) {">
					<outline text="ctTests++;"/>
					<outline text="if (flCondition) {">
						<outline text="console.log (&quot;ok -- &quot; + theMessage);"/>
						<outline text="}"/>
						</outline>
					<outline text="else {">
						<outline text="ctFailures++;"/>
						<outline text="console.log (&quot;FAILED -- &quot; + theMessage);"/>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="//the pretend web: a table of OPML files, each with a version number that becomes its etag">
					<outline text="const theWebFiles = {};"/>
					<outline text="function setWebFile (theName, opmltext) {">
						<outline text="if (theWebFiles [theName] === undefined) {">
							<outline text="theWebFiles [theName] = {version: 0};"/>
							<outline text="}"/>
							</outline>
						<outline text="theWebFiles [theName].opmltext = opmltext;"/>
						<outline text="theWebFiles [theName].version++;"/>
						<outline text="}"/>
						</outline>
					<outline text="const theServer = http.createServer (function (theRequest, theResponse) {">
						<outline text="const theName = theRequest.url.substring (1);"/>
						<outline text="const theFile = theWebFiles [theName];"/>
						<outline text="if (theFile === undefined) {">
							<outline text="theResponse.writeHead (404, {&quot;Content-Type&quot;: &quot;text/plain&quot;});"/>
							<outline text="theResponse.end (&quot;Not found.&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="const theEtag = &quot;\&quot;v&quot; + theFile.version + &quot;\&quot;&quot;;"/>
							<outline text="if (theRequest.headers [&quot;if-none-match&quot;] === theEtag) {">
								<outline text="theResponse.writeHead (304);"/>
								<outline text="theResponse.end ();"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="theResponse.writeHead (200, {&quot;Content-Type&quot;: &quot;text/xml&quot;, &quot;ETag&quot;: theEtag});"/>
								<outline text="theResponse.end (theFile.opmltext);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					</outline>
				<outline text=""/>
				<outline text="function opmlForFeeds (theTitle, theFeeds) { //build a reading list; a feed can be a string or {feedUrl, category, flComment}">
					<outline text="var itemtext = &quot;&quot;;"/>
					<outline text="theFeeds.forEach (function (theFeed) {">
						<outline text="if (typeof (theFeed) === &quot;string&quot;) {">
							<outline text="theFeed = {feedUrl: theFeed};"/>
							<outline text="}"/>
							</outline>
						<outline text="var atts = &quot;type=\&quot;rss\&quot; text=\&quot;&quot; + theFeed.feedUrl + &quot;\&quot; xmlUrl=\&quot;&quot; + theFeed.feedUrl + &quot;\&quot;&quot;;"/>
						<outline text="if (theFeed.category !== undefined) {">
							<outline text="atts += &quot; category=\&quot;&quot; + theFeed.category + &quot;\&quot;&quot;;"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theFeed.flComment) {">
							<outline text="atts += &quot; isComment=\&quot;true\&quot;&quot;;"/>
							<outline text="}"/>
							</outline>
						<outline text="itemtext += &quot;\t\t&lt;outline &quot; + atts + &quot;/&gt;\n&quot;;"/>
						<outline text="});"/>
						</outline>
					<outline text="var headtext = &quot;&quot;;"/>
					<outline text="if (theTitle !== undefined) {">
						<outline text="headtext = &quot;\t&lt;head&gt;\n\t\t&lt;title&gt;&quot; + theTitle + &quot;&lt;/title&gt;\n\t\t&lt;description&gt;A list for testing.&lt;/description&gt;\n\t\t&lt;/head&gt;\n&quot;;"/>
						<outline text="}"/>
						</outline>
					<outline text="return (&quot;&lt;?xml version=\&quot;1.0\&quot; encoding=\&quot;UTF-8\&quot;?&gt;\n&lt;opml version=\&quot;2.0\&quot;&gt;\n&quot; + headtext + &quot;\t&lt;body&gt;\n&quot; + itemtext + &quot;\t\t&lt;/body&gt;\n\t&lt;/opml&gt;\n&quot;);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="//the pretend reader app">
					<outline text="var theApp; //assigned by newApp"/>
					<outline text="function newApp () {">
						<outline text="theApp = {">
							<outline text="subscriptions: {}, //feedUrl: the listInfo that came with the subscribe call"/>
							<outline text="personalFeeds: {}, //feeds the user subscribed to on their own"/>
							<outline text="log: []"/>
							<outline text="};"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function appCallbacks () {">
						<outline text="return ({">
							<outline text="isSubscribed: function (feedUrl, callback) {">
								<outline text="callback ((theApp.subscriptions [feedUrl] !== undefined) || (theApp.personalFeeds [feedUrl] !== undefined));"/>
								<outline text="},"/>
								</outline>
							<outline text="subscribe: function (feedUrl, listInfo, callback) {">
								<outline text="theApp.subscriptions [feedUrl] = listInfo;"/>
								<outline text="theApp.log.push (&quot;subscribe &quot; + feedUrl);"/>
								<outline text="callback ();"/>
								<outline text="},"/>
								</outline>
							<outline text="unsubscribe: function (feedUrl, callback) {">
								<outline text="delete theApp.subscriptions [feedUrl];"/>
								<outline text="theApp.log.push (&quot;unsubscribe &quot; + feedUrl);"/>
								<outline text="callback ();"/>
								<outline text="},"/>
								</outline>
							<outline text="loadState: function (callback) {">
								<outline text="callback (undefined, theApp.savedState);"/>
								<outline text="},"/>
								</outline>
							<outline text="saveState: function (theState, callback) {">
								<outline text="theApp.savedState = JSON.parse (JSON.stringify (theState)); //what a file or database would hold"/>
								<outline text="callback ();"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function ctSubscriptions () {">
						<outline text="return (Object.keys (theApp.subscriptions).length);"/>
						<outline text="}"/>
						</outline>
					<outline text="function ctLogLines (theText) { //how many times the app heard exactly this">
						<outline text="var ct = 0;"/>
						<outline text="theApp.log.forEach (function (theLine) {">
							<outline text="if (theLine === theText) {">
								<outline text="ct++;"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (ct);"/>
						<outline text="}"/>
						</outline>
					</outline>
				<outline text=""/>
				<outline text="theServer.listen (testPort, function () {">
					<outline text="setWebFile (&quot;listA.opml&quot;, opmlForFeeds (&quot;List A&quot;, [">
						<outline text="{feedUrl: &quot;http://feeds.example/one.xml&quot;, category: &quot;tech&quot;},"/>
						<outline text="&quot;http://feeds.example/two.xml&quot;,"/>
						<outline text="&quot;http://feeds.example/three.xml&quot;,"/>
						<outline text="{feedUrl: &quot;http://feeds.example/hidden.xml&quot;, flComment: true}"/>
						<outline text="]));"/>
						</outline>
					<outline text="setWebFile (&quot;listB.opml&quot;, opmlForFeeds (&quot;List B&quot;, [">
						<outline text="&quot;http://feeds.example/three.xml&quot;,"/>
						<outline text="&quot;http://feeds.example/five.xml&quot;"/>
						<outline text="]));"/>
						</outline>
					<outline text="setWebFile (&quot;headless.opml&quot;, opmlForFeeds (undefined, [">
						<outline text="&quot;http://feeds.example/six.xml&quot;"/>
						<outline text="]));"/>
						</outline>
					<outline text="setWebFile (&quot;broken.opml&quot;, &quot;this is not opml at all &lt;&gt;&lt;&quot;);"/>
					<outline text=""/>
					<outline text="newApp ();"/>
					<outline text="theApp.personalFeeds [&quot;http://feeds.example/two.xml&quot;] = true; //the user's own, from before any list"/>
					<outline text=""/>
					<outline text="const theManager = new readinglist.readingListManager (appCallbacks ());"/>
					<outline text=""/>
					<outline text="theManager.start (function (err) {">
						<outline text="assert (err === undefined, &quot;the manager starts with no saved state&quot;);"/>
						<outline text=""/>
						<outline text="theManager.followList (urlServer + &quot;listA.opml&quot;, function (err, listRec) {">
							<outline text="assert (err === undefined, &quot;following list A works&quot;);"/>
							<outline text="assert (listRec.title === &quot;List A&quot;, &quot;the list's title came from the OPML head&quot;);"/>
							<outline text="assert (listRec.feedUrls.length === 3, &quot;the comment node stayed invisible -- 3 feeds, not 4&quot;);"/>
							<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/one.xml&quot;] !== undefined, &quot;feed one was subscribed&quot;);"/>
							<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/one.xml&quot;].categories === &quot;tech&quot;, &quot;the category rode along with the subscribe call&quot;);"/>
							<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/two.xml&quot;] === undefined, &quot;feed two was NOT subscribed -- the user already had it personally&quot;);"/>
							<outline text="assert (ctSubscriptions () === 2, &quot;exactly two subscribe calls for list A&quot;);"/>
							<outline text=""/>
							<outline text="theManager.followList (urlServer + &quot;listA.opml&quot;, function (err, listRec) {">
								<outline text="assert ((err === undefined) &amp;&amp; (ctSubscriptions () === 2), &quot;following the same list again changes nothing&quot;);"/>
								<outline text=""/>
								<outline text="theManager.followList (urlServer + &quot;listB.opml&quot;, function (err, listRec) {">
									<outline text="assert (err === undefined, &quot;following list B works&quot;);"/>
									<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/five.xml&quot;] !== undefined, &quot;feed five was subscribed&quot;);"/>
									<outline text="assert (ctLogLines (&quot;subscribe http://feeds.example/three.xml&quot;) === 1, &quot;feed three was subscribed once, not twice -- list A already carried it&quot;);"/>
									<outline text=""/>
									<outline text="theManager.checkList (urlServer + &quot;listA.opml&quot;, function (err, theChanges) {">
										<outline text="assert ((err === undefined) &amp;&amp; (theChanges.flUnchanged === true), &quot;an unchanged list answers 304 and nothing happens&quot;);"/>
										<outline text=""/>
										<outline text="//list A changes: drops one, two and three, adds four">
											<outline text="setWebFile (&quot;listA.opml&quot;, opmlForFeeds (&quot;List A&quot;, [">
												<outline text="&quot;http://feeds.example/four.xml&quot;"/>
												<outline text="]));"/>
												</outline>
											</outline>
										<outline text="theManager.checkList (urlServer + &quot;listA.opml&quot;, function (err, theChanges) {">
											<outline text="assert (err === undefined, &quot;checking the changed list works&quot;);"/>
											<outline text="assert ((theChanges.adds.length === 1) &amp;&amp; (theChanges.adds [0] === &quot;http://feeds.example/four.xml&quot;), &quot;the added feed was reported&quot;);"/>
											<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/four.xml&quot;] !== undefined, &quot;the added feed was subscribed&quot;);"/>
											<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/one.xml&quot;] === undefined, &quot;the dropped feed was unsubscribed&quot;);"/>
											<outline text="assert (theApp.personalFeeds [&quot;http://feeds.example/two.xml&quot;] !== undefined, &quot;THE RULE: the user's personal feed survived being dropped from the list&quot;);"/>
											<outline text="assert (ctLogLines (&quot;unsubscribe http://feeds.example/two.xml&quot;) === 0, &quot;no unsubscribe call ever fired for the personal feed&quot;);"/>
											<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/three.xml&quot;] !== undefined, &quot;THE RULE: feed three survived -- list B still carries it&quot;);"/>
											<outline text=""/>
											<outline text="theManager.unfollowList (urlServer + &quot;listB.opml&quot;, function (err) {">
												<outline text="assert (err === undefined, &quot;unfollowing list B works&quot;);"/>
												<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/three.xml&quot;] === undefined, &quot;feed three went when its last list let go&quot;);"/>
												<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/five.xml&quot;] === undefined, &quot;feed five went with list B&quot;);"/>
												<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/four.xml&quot;] !== undefined, &quot;list A's feed stayed&quot;);"/>
												<outline text=""/>
												<outline text="theManager.followList (urlServer + &quot;headless.opml&quot;, function (err, listRec) {">
													<outline text="assert (err === undefined, &quot;a list with no head section still works&quot;);"/>
													<outline text="assert (listRec.title === undefined, &quot;its title is honestly undefined&quot;);"/>
													<outline text=""/>
													<outline text="theManager.followList (urlServer + &quot;broken.opml&quot;, function (err) {">
														<outline text="assert (err !== undefined, &quot;a file that isn't OPML answers with an error, not a crash&quot;);"/>
														<outline text="assert (err.message.indexOf (&quot;Can't&quot;) === 0, &quot;the error message says what couldn't be done&quot;);"/>
														<outline text=""/>
														<outline text="theManager.followList (&quot;http://localhost:1/nothing.opml&quot;, function (err) {">
															<outline text="assert (err !== undefined, &quot;an unreachable address answers with an error&quot;);"/>
															<outline text=""/>
															<outline text="theManager.followList (&quot;not a url at all&quot;, function (err) {">
																<outline text="assert (err !== undefined, &quot;a non-url answers with an error&quot;);"/>
																<outline text=""/>
																<outline text="//a brand new manager instance picks up the saved state, like an app relaunching">
																	<outline text="const secondManager = new readinglist.readingListManager (appCallbacks ());"/>
																	<outline text="secondManager.start (function (err) {">
																		<outline text="secondManager.getLists (function (err, theLists) {">
																			<outline text="assert (theLists.length === 2, &quot;a fresh instance loads the saved state -- still following 2 lists&quot;);"/>
																			<outline text="setWebFile (&quot;listA.opml&quot;, opmlForFeeds (&quot;List A&quot;, [">
																				<outline text="&quot;http://feeds.example/four.xml&quot;,"/>
																				<outline text="&quot;http://feeds.example/seven.xml&quot;"/>
																				<outline text="]));"/>
																				</outline>
																			<outline text="secondManager.checkLists (function (err, theReports) {">
																				<outline text="assert (err === undefined, &quot;checkLists sweeps every followed list&quot;);"/>
																				<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/seven.xml&quot;] !== undefined, &quot;the relaunched app still tracks the list -- new feed subscribed&quot;);"/>
																				<outline text="var theReport;"/>
																				<outline text="theReports.forEach (function (item) {">
																					<outline text="if (item.opmlUrl === urlServer + &quot;listA.opml&quot;) {">
																						<outline text="theReport = item;"/>
																						<outline text="}"/>
																						</outline>
																					<outline text="});"/>
																					</outline>
																				<outline text="assert ((theReport !== undefined) &amp;&amp; (theReport.adds.length === 1), &quot;the sweep reported the change per-list&quot;);"/>
																				<outline text=""/>
																				<outline text="console.log (&quot;\n&quot; + ctTests + &quot; tests, &quot; + (ctTests - ctFailures) + &quot; passed, &quot; + ctFailures + &quot; failed.&quot;);"/>
																				<outline text="theServer.close ();"/>
																				<outline text="process.exit ((ctFailures === 0) ? 0 : 1);"/>
																				<outline text="});"/>
																				</outline>
																			<outline text="});"/>
																			</outline>
																		<outline text="});"/>
																		</outline>
																	</outline>
																<outline text="});"/>
																</outline>
															<outline text="});"/>
															</outline>
														<outline text="});"/>
														</outline>
													<outline text="});"/>
													</outline>
												<outline text="});"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="demo.js">
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const readinglist = require (&quot;./readinglist.js&quot;);"/>
				<outline text=""/>
				<outline text="const pathStateFile = &quot;state.json&quot;;"/>
				<outline text="const opmlUrl = process.argv [2];"/>
				<outline text=""/>
				<outline text="if (opmlUrl === undefined) {">
					<outline text="console.log (&quot;Usage: node demo.js &lt;url-of-reading-list&gt;&quot;);"/>
					<outline text="process.exit (1);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const theManager = new readinglist.readingListManager ({">
					<outline text="isSubscribed: function (feedUrl, callback) {">
						<outline text="callback (false); //this demo has no subscriptions of its own"/>
						<outline text="},"/>
						</outline>
					<outline text="subscribe: function (feedUrl, listInfo, callback) {">
						<outline text="console.log (&quot;subscribe: &quot; + feedUrl + ((listInfo.categories === undefined) ? &quot;&quot; : &quot; (&quot; + listInfo.categories + &quot;)&quot;));"/>
						<outline text="callback ();"/>
						<outline text="},"/>
						</outline>
					<outline text="unsubscribe: function (feedUrl, callback) {">
						<outline text="console.log (&quot;unsubscribe: &quot; + feedUrl);"/>
						<outline text="callback ();"/>
						<outline text="},"/>
						</outline>
					<outline text="loadState: function (callback) {">
						<outline text="fs.readFile (pathStateFile, &quot;utf8&quot;, function (err, filetext) {">
							<outline text="if (err) { //no file yet -- first run">
								<outline text="callback (undefined, undefined);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="var theState;"/>
								<outline text="try {">
									<outline text="theState = JSON.parse (filetext);"/>
									<outline text="}"/>
									</outline>
								<outline text="catch (err) {">
									<outline text="callback ({message: &quot;Can't read the saved state because it isn't valid JSON.&quot;});"/>
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="callback (undefined, theState);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="},"/>
						</outline>
					<outline text="saveState: function (theState, callback) {">
						<outline text="fs.writeFile (pathStateFile, JSON.stringify (theState, undefined, &quot;\t&quot;), function (err) {">
							<outline text="callback (err);"/>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="theManager.start (function (err) {">
					<outline text="if (err) {">
						<outline text="console.log (err.message);"/>
						<outline text="}"/>
						</outline>
					<outline text="else {">
						<outline text="theManager.getLists (function (err, theLists) {">
							<outline text="var flAlreadyFollowing = false;"/>
							<outline text="theLists.forEach (function (listRec) {">
								<outline text="if (listRec.opmlUrl === opmlUrl) {">
									<outline text="flAlreadyFollowing = true;"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="if (flAlreadyFollowing) { //second run and later: just check for changes">
								<outline text="theManager.checkList (opmlUrl, function (err, theChanges) {">
									<outline text="if (err) {">
										<outline text="console.log (err.message);"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="if (theChanges.flUnchanged) {">
											<outline text="console.log (&quot;The list hasn't changed since last time.&quot;);"/>
											<outline text="}"/>
											</outline>
										<outline text="else {">
											<outline text="console.log (theChanges.adds.length + &quot; added, &quot; + theChanges.removes.length + &quot; removed.&quot;);"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="theManager.followList (opmlUrl, function (err, listRec) {">
									<outline text="if (err) {">
										<outline text="console.log (err.message);"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="const theTitle = (listRec.title === undefined) ? opmlUrl : listRec.title;"/>
										<outline text="console.log (&quot;\nNow following \&quot;&quot; + theTitle + &quot;\&quot; -- &quot; + listRec.feedUrls.length + &quot; feeds.&quot;);"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="agentbriefing.md">
				<outline text="# Briefing for agents">
					<outline text="If you're an AI agent helping someone use or change this package, this file is for you -- whatever you're called, you're welcome here. The readme says what the package is and demo.js shows it working. This file holds what the code can't tell you: the state of the work and the decisions behind it."/>
					</outline>
				<outline text="### The state of things, August 2, 2026">
					<outline text="The package began as an example in the rss.chat repo and moved here August 2, 2026, because reading lists belong to the FeedLand side of this family of products. The name readinglist is unclaimed on npm; it hasn't been published there yet. The current version is 0.4.0. The demo is being offered quietly to friends to see what questions they ask and whether they get it working."/>
					</outline>
				<outline text="### How the pieces sit">
					<outline text="The package and the demo live in code/. The tests live in misc/ -- after any change to readinglist.js, run test.js from inside the misc folder; all 34 checks should pass. Run npm install in code/ first so the one dependency, the opml package, is present."/>
					<outline text="The files in this repo are rendered from an outline the maintainer edits -- the source of truth is not here. If you change a file directly, propose the change through an issue or pull request rather than assuming an edit will stick; the next build regenerates the files from the outline."/>
					</outline>
				<outline text="### Rules to preserve">
					<outline text="1. The survival rule, item 3 in the readme, is the heart of the package. test.js checks both halves of it. Whatever you change, don't break it."/>
					<outline text="2. The code style is deliberate and consistent: callbacks rather than promises, error objects with a message property rather than bare strings, forEach rather than map or filter, tabs for indentation, a space before call parentheses. Match it."/>
					<outline text="3. Never document anything twice. If the demo, the readme or a comment in the code already says it, point there instead of restating."/>
					</outline>
				</outline>
			<outline text="readme.md" created="Sun, 02 Aug 2026 17:05:54 GMT">
				<outline text="# readinglist" created="Sun, 02 Aug 2026 17:05:58 GMT">
					<outline text="A node package that manages OPML reading lists for a feed reader. " created="Sun, 02 Aug 2026 17:09:17 GMT"/>
					</outline>
				<outline text="### What is a reading list?" created="Sun, 02 Aug 2026 17:13:07 GMT">
					<outline text="It's an OPML subscription list that a feed reader app subscribes to. When a new item shows up in the list, the feed reader subscribes to it. When one is removed, the subscription is removed. " created="Sun, 02 Aug 2026 17:13:13 GMT"/>
					</outline>
				<outline text="### The app and this package" created="Sun, 02 Aug 2026 17:13:59 GMT">
					<outline text="If your app uses this package, this is how the two connect." created="Sun, 02 Aug 2026 17:15:35 GMT">
						<outline text="1. The app owns its subscriptions, storage and screens. " created="Sun, 02 Aug 2026 17:16:03 GMT"/>
						<outline text="2. This package owns the lists: it reads a reading list, remembers what the list said last time, diffs, and tells the app what changed through two callbacks." created="Sun, 02 Aug 2026 17:17:08 GMT"/>
						<outline text="3. The rule the package enforces: a feed the user subscribed to personally is never removed because a list dropped it, and a feed two lists both carry survives until the last list lets go." created="Sun, 02 Aug 2026 17:16:26 GMT"/>
						</outline>
					</outline>
				<outline text="### Demo" created="Sun, 02 Aug 2026 17:10:39 GMT">
					<outline text="demo.js is a tiny reader app built on  readinglist.js. " created="Sun, 02 Aug 2026 17:23:03 GMT"/>
					<outline text="It &quot;subscribes&quot; by printing to the console, and keeps its state in state.json in this folder, so you can run it twice and watch the second run find only what changed."/>
					<outline text="This is how you launch it, it requires an OPML file to watch" created="Sun, 02 Aug 2026 17:27:12 GMT"/>
					<outline text="`node demo.js &quot;https://feedland.social/opml?screenname=davewiner&amp;catname=blogroll&quot;`"/>
					</outline>
				<outline text="### What is test.js" created="Sun, 02 Aug 2026 17:29:39 GMT">
					<outline text="An app we use to be sure that it hasn't broken, we left it in because why not? It's in the misc folder." created="Sun, 02 Aug 2026 17:29:44 GMT"/>
					</outline>
				</outline>
			<outline text="readmeOrig.md" isComment="true">
				<outline text="# Reading lists in your feed reader"/>
				<outline text=""/>
				<outline text="A reading list is a subscription list that lives at a URL, maintained by its editor, followed by readers. When the editor adds a feed, everyone following the list gets it. When they drop one, it goes away. The list is the subscription -- the feeds come and go on the editor's say-so."/>
				<outline text=""/>
				<outline text="This changes where subscriptions live. Instead of being locked inside one reader's storage, a person's subscriptions can live at an address on the web, and any reader that supports reading lists can follow them. Someone who keeps their list at one place can sit down at a different reader, hand it one URL, and be home."/>
				<outline text=""/>
				<outline text="This page is for people who make feed readers and podcast apps -- a reading list of podcast feeds works exactly the same way. It has three parts: the behavior contract, which you can implement in any language; a reference implementation in node, small enough to read in one sitting; and a test suite that doubles as the contract restated as code."/>
				<outline text=""/>
				<outline text="## What a reading list is"/>
				<outline text=""/>
				<outline text="An OPML file at a URL. Each feed is an `outline` node with `type=&quot;rss&quot;` and the feed's address in `xmlUrl`. Nodes may carry `text` (the feed's name), `htmlUrl` (its website) and `category`. A node with `isComment=&quot;true&quot;` is invisible, along with everything nested under it. The file's `head` section may carry a `title` and `description` for the list itself -- or may be missing entirely, which is still a valid list."/>
				<outline text=""/>
				<outline text="A real one to look at: [Dave Winer's blogroll](https://feedland.social/opml?screenname=davewiner&amp;catname=blogroll), 229 feeds."/>
				<outline text=""/>
				<outline text="## The behavior contract"/>
				<outline text=""/>
				<outline text="If your app does these six things, it supports reading lists. Nothing here depends on node, or on any server of ours."/>
				<outline text=""/>
				<outline text="1. **Follow.** The user gives you the URL of a list. Read it, parse it, and subscribe to each feed it names, the way your app subscribes to anything. Show the user the list's title and description."/>
				<outline text="2. **Remember.** For each followed list, keep a small record: the feed urls from the last read, the list's title and description, when you last checked, and the `ETag` or `Last-Modified` the server sent."/>
				<outline text="3. **Check.** On a timer -- once an hour is plenty -- re-read each followed list, sending `If-None-Match` or `If-Modified-Since` from your record. A `304` means nothing changed and you're done, at almost no cost to the server. Otherwise diff the new feed list against your record: subscribe to the feeds that appeared, unsubscribe from the feeds that left, and update the record. This is the feature -- the list's editor is maintaining your user's subscriptions."/>
				<outline text="4. **Respect what's the user's own.** A feed the user subscribed to personally is never removed because a list dropped it. A feed that two followed lists both carry survives until the last one lets go. To honor this, before subscribing on a list's behalf, ask your own database whether the subscription already exists -- if it does, mark it as the user's own and don't claim it for the list."/>
				<outline text="5. **Unfollow.** When the user unfollows a list, unwind its feeds by the same rule: keep what another list still carries, keep what was the user's own, unsubscribe the rest."/>
				<outline text="6. **Fail quietly.** A list that's unreachable or briefly broken changes nothing -- keep the subscriptions as they are and try again next time. Can't reach isn't the same as isn't there."/>
				<outline text=""/>
				<outline text="## The node reference implementation"/>
				<outline text=""/>
				<outline text="[readinglist.js](readinglist.js) is the contract implemented, with the state-keeping and the rules of items 2 through 6 done for you. You connect it to your app with a handful of callbacks, and it never touches your storage or your network beyond the lists themselves."/>
				<outline text=""/>
				<outline text="```javascript"/>
				<outline text="const readinglist = require (&quot;./readinglist.js&quot;);"/>
				<outline text=""/>
				<outline text="const theManager = new readinglist.readingListManager ({">
					<outline text="isSubscribed: function (feedUrl, callback) {">
						<outline text="callback (myApp.hasSubscription (feedUrl)); //does the app already subscribe?"/>
						<outline text="},"/>
						</outline>
					<outline text="subscribe: function (feedUrl, listInfo, callback) {">
						<outline text="myApp.addSubscription (feedUrl, listInfo.text, listInfo.categories);"/>
						<outline text="callback ();"/>
						<outline text="},"/>
						</outline>
					<outline text="unsubscribe: function (feedUrl, callback) {">
						<outline text="myApp.removeSubscription (feedUrl);"/>
						<outline text="callback ();"/>
						<outline text="},"/>
						</outline>
					<outline text="loadState: function (callback) { //hand back what saveState gave you -- undefined the first time">
						<outline text="callback (undefined, myApp.loadJsonFile (&quot;readinglists.json&quot;));"/>
						<outline text="},"/>
						</outline>
					<outline text="saveState: function (theState, callback) {">
						<outline text="myApp.saveJsonFile (&quot;readinglists.json&quot;, theState);"/>
						<outline text="callback ();"/>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="theManager.start (function (err) {">
					<outline text="theManager.followList (&quot;https://feedland.social/opml?screenname=davewiner&amp;catname=blogroll&quot;, function (err, listRec) {">
						<outline text="console.log (&quot;Following \&quot;&quot; + listRec.title + &quot;\&quot; -- &quot; + listRec.feedUrls.length + &quot; feeds.&quot;);"/>
						<outline text="});"/>
						</outline>
					<outline text="});"/>
					</outline>
				<outline text="```"/>
				<outline text=""/>
				<outline text="Then, on your timer:"/>
				<outline text=""/>
				<outline text="```javascript"/>
				<outline text="theManager.checkLists (function (err, theReports) { //your subscribe/unsubscribe callbacks fire as needed">
					<outline text="});"/>
					</outline>
				<outline text="```"/>
				<outline text=""/>
				<outline text="The full surface: `start`, `followList`, `unfollowList`, `checkList`, `checkLists`, `getLists`. Every callback gets an error object with a `message` when something goes wrong, and never throws."/>
				<outline text=""/>
				<outline text="## The tests"/>
				<outline text=""/>
				<outline text="Run `node test.js`. It starts a little local web server playing the role of the lists, wires up a pretend reader app, and walks the whole contract -- 34 checks, including both halves of the survival rule in item 4. If you're implementing in another language, porting this file is the fastest way to know you got it right."/>
				<outline text=""/>
				<outline text="## Try it"/>
				<outline text=""/>
				<outline text="[demo.js](demo.js) is a five-minute reader: it subscribes by printing. Point it at a real list, then run it again and watch it find nothing to do:"/>
				<outline text=""/>
				<outline text="```"/>
				<outline text="node demo.js &quot;https://feedland.social/opml?screenname=davewiner&amp;catname=blogroll&quot;"/>
				<outline text="```"/>
				<outline text=""/>
				<outline text="## Other languages"/>
				<outline text=""/>
				<outline text="The contract is the spec -- the node code is one rendering of it. If you work in Swift, Rust, Go, C++ or anything else and want this in your language, post an issue on this repo and we'll help, up to and including doing the translation. The point of this page is more apps that follow reading lists, wherever they're written."/>
				</outline>
			</outline>
		<outline text="/scripting.com/code/feedland/apps/readinglist/" isComment="true" created="Sun, 02 Aug 2026 17:04:10 GMT">
			<outline text="worknotes.md" created="Sun, 02 Aug 2026 17:05:05 GMT">
				<outline text="#### 8/2/26; 1:05:13 PM by DW" created="Sun, 02 Aug 2026 17:05:08 GMT">
					<outline text="Started." created="Sun, 02 Aug 2026 17:05:14 GMT"/>
					</outline>
				</outline>
			<outline text="package.json">
				<outline text="{">
					<outline text="&quot;name&quot;: &quot;readinglist&quot;,"/>
					<outline text="&quot;description&quot;: &quot;Follow OPML reading lists in a feed reader -- reads a list, diffs against last time, tells your app what changed.&quot;,"/>
					<outline text="&quot;author&quot;: &quot;Dave Winer &lt;dave@scripting.com&gt;&quot;,"/>
					<outline text="&quot;version&quot;: &quot;0.4.0&quot;,"/>
					<outline text="&quot;main&quot;: &quot;readinglist.js&quot;,"/>
					<outline text="&quot;license&quot;: &quot;MIT&quot;,"/>
					<outline text="&quot;dependencies&quot;: {">
						<outline text="&quot;opml&quot;: &quot;0.5.8&quot;"/>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				</outline>
			<outline text="readinglist.js">
				<outline text="const myVersion = &quot;0.4.0&quot;, myProductName = &quot;readinglist&quot;; " created="Mon, 03 Feb 2014 03:21:03 GMT" pgfnum="36831"/>
				<outline text="" created="Sun, 02 Aug 2026 17:38:01 GMT"/>
				<outline text="exports.readingListManager = readingListManager;"/>
				<outline text="" created="Sun, 02 Aug 2026 17:19:07 GMT"/>
				<outline text="const https = require (&quot;https&quot;);"/>
				<outline text="const http = require (&quot;http&quot;);"/>
				<outline text="const opml = require (&quot;opml&quot;);"/>
				<outline text=""/>
				<outline text="function readingListManager (userOptions) {">
					<outline text="var options = {">
						<outline text="isSubscribed: function (feedUrl, callback) { //asks the app: already subscribed? callback (flSubscribed)">
							<outline text="callback (false);"/>
							<outline text="},"/>
							</outline>
						<outline text="subscribe: function (feedUrl, listInfo, callback) { //the app makes the subscription. callback (err)">
							<outline text="callback ();"/>
							<outline text="},"/>
							</outline>
						<outline text="unsubscribe: function (feedUrl, callback) { //the app removes it. callback (err)">
							<outline text="callback ();"/>
							<outline text="},"/>
							</outline>
						<outline text="loadState: function (callback) { //callback (err, theState) -- undefined the first time ever">
							<outline text="callback (undefined, undefined);"/>
							<outline text="},"/>
							</outline>
						<outline text="saveState: function (theState, callback) { //theState is a plain object, safe to stringify">
							<outline text="callback ();"/>
							<outline text="},"/>
							</outline>
						<outline text="userAgent: &quot;readinglist for node&quot;"/>
						<outline text="};"/>
						</outline>
					<outline text="for (var x in userOptions) {">
						<outline text="options [x] = userOptions [x];"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="var theState; //assigned by start -- {lists: {opmlUrl: listRec}, personalFeeds: {feedUrl: true}}"/>
					<outline text=""/>
					<outline text="function readUrl (theUrl, condGetInfo, callback) { //callback (err, {flNotModified} or {filetext, etag, lastModified})">
						<outline text="var theParsed;"/>
						<outline text="try {">
							<outline text="theParsed = new URL (theUrl);"/>
							<outline text="}"/>
							</outline>
						<outline text="catch (err) {">
							<outline text="const message = &quot;Can't read &quot; + theUrl + &quot; because it isn't a valid address.&quot;;"/>
							<outline text="callback ({message});"/>
							<outline text="return;"/>
							<outline text="}"/>
							</outline>
						<outline text="const theProtocol = (theParsed.protocol === &quot;http:&quot;) ? http : https;"/>
						<outline text="const theHeaders = {">
							<outline text="&quot;User-Agent&quot;: options.userAgent"/>
							<outline text="};"/>
							</outline>
						<outline text="if (condGetInfo.etag !== undefined) {">
							<outline text="theHeaders [&quot;If-None-Match&quot;] = condGetInfo.etag;"/>
							<outline text="}"/>
							</outline>
						<outline text="if (condGetInfo.lastModified !== undefined) {">
							<outline text="theHeaders [&quot;If-Modified-Since&quot;] = condGetInfo.lastModified;"/>
							<outline text="}"/>
							</outline>
						<outline text="const theRequest = theProtocol.get (theUrl, {headers: theHeaders}, function (theResponse) {">
							<outline text="if (theResponse.statusCode === 304) { //the list hasn't changed since last time">
								<outline text="theResponse.resume ();"/>
								<outline text="callback (undefined, {flNotModified: true});"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if ((theResponse.statusCode &gt;= 301) &amp;&amp; (theResponse.statusCode &lt;= 308)) { //follow a redirect">
									<outline text="theResponse.resume ();"/>
									<outline text="const theLocation = theResponse.headers.location;"/>
									<outline text="if ((theLocation === undefined) || (condGetInfo.ctRedirects &gt;= 5)) {">
										<outline text="const message = &quot;Can't read &quot; + theUrl + &quot; because the redirect couldn't be followed.&quot;;"/>
										<outline text="callback ({message});"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="const nextCondGetInfo = {">
											<outline text="etag: condGetInfo.etag,"/>
											<outline text="lastModified: condGetInfo.lastModified,"/>
											<outline text="ctRedirects: (condGetInfo.ctRedirects === undefined) ? 1 : condGetInfo.ctRedirects + 1"/>
											<outline text="};"/>
											</outline>
										<outline text="readUrl (new URL (theLocation, theUrl).toString (), nextCondGetInfo, callback);"/>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (theResponse.statusCode !== 200) {">
										<outline text="theResponse.resume ();"/>
										<outline text="const message = &quot;Can't read &quot; + theUrl + &quot; because the server answered with a &quot; + theResponse.statusCode + &quot;.&quot;;"/>
										<outline text="callback ({message});"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="var filetext = &quot;&quot;;"/>
										<outline text="theResponse.setEncoding (&quot;utf8&quot;);"/>
										<outline text="theResponse.on (&quot;data&quot;, function (theChunk) {">
											<outline text="filetext += theChunk;"/>
											<outline text="});"/>
											</outline>
										<outline text="theResponse.on (&quot;end&quot;, function () {">
											<outline text="callback (undefined, {">
												<outline text="filetext,"/>
												<outline text="etag: theResponse.headers [&quot;etag&quot;],"/>
												<outline text="lastModified: theResponse.headers [&quot;last-modified&quot;]"/>
												<outline text="});"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="theRequest.on (&quot;error&quot;, function (err) {">
							<outline text="const message = &quot;Can't read &quot; + theUrl + &quot; because &quot; + err.message + &quot;.&quot;;"/>
							<outline text="callback ({message});"/>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function isComment (theNode) { //comment nodes and everything under them are invisible">
						<outline text="return ((theNode.isComment === &quot;true&quot;) || (theNode.isComment === true));"/>
						<outline text="}"/>
						</outline>
					<outline text="function readList (opmlUrl, condGetInfo, callback) { //callback (err, {flNotModified} or {title, description, feeds, etag, lastModified})">
						<outline text="readUrl (opmlUrl, condGetInfo, function (err, theResult) {">
							<outline text="if (err) {">
								<outline text="callback (err);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if (theResult.flNotModified) {">
									<outline text="callback (undefined, theResult);"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="opml.parse (theResult.filetext, function (err, theOutline) {">
										<outline text="if (err) {">
											<outline text="const message = &quot;Can't understand the list at &quot; + opmlUrl + &quot; because it isn't valid OPML.&quot;;"/>
											<outline text="callback ({message});"/>
											<outline text="}"/>
											</outline>
										<outline text="else {">
											<outline text="var title, description;"/>
											<outline text="if (theOutline.opml.head !== undefined) { //a list with no head section is still a list">
												<outline text="title = theOutline.opml.head.title;"/>
												<outline text="description = theOutline.opml.head.description;"/>
												<outline text="}"/>
												</outline>
											<outline text="const theFeeds = [];"/>
											<outline text="opml.visitAll (theOutline, function (theNode) {">
												<outline text="if (!isComment (theNode)) {">
													<outline text="if (theNode.type === &quot;rss&quot;) {">
														<outline text="if (theNode.xmlUrl !== undefined) {">
															<outline text="theFeeds.push ({">
																<outline text="feedUrl: theNode.xmlUrl,"/>
																<outline text="text: theNode.text,"/>
																<outline text="htmlUrl: theNode.htmlUrl,"/>
																<outline text="categories: theNode.category"/>
																<outline text="});"/>
																</outline>
															<outline text="}"/>
															</outline>
														<outline text="}"/>
														</outline>
													<outline text="}"/>
													</outline>
												<outline text="return (true); //keep visiting"/>
												<outline text="});"/>
												</outline>
											<outline text="callback (undefined, {">
												<outline text="title, description,"/>
												<outline text="feeds: theFeeds,"/>
												<outline text="etag: theResult.etag,"/>
												<outline text="lastModified: theResult.lastModified"/>
												<outline text="});"/>
												</outline>
											<outline text="}"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function ctOtherProviders (feedUrl, opmlUrlToSkip) { //how many OTHER followed lists carry this feed">
						<outline text="var ct = 0;"/>
						<outline text="Object.keys (theState.lists).forEach (function (theListUrl) {">
							<outline text="if (theListUrl !== opmlUrlToSkip) {">
								<outline text="theState.lists [theListUrl].feedUrls.forEach (function (theFeedUrl) {">
									<outline text="if (theFeedUrl === feedUrl) {">
										<outline text="ct++;"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (ct);"/>
						<outline text="}"/>
						</outline>
					<outline text="function saveTheState (callback) {">
						<outline text="options.saveState (theState, function (err) {">
							<outline text="callback (err);"/>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function subscribeOnBehalfOfList (theFeeds, opmlUrl, callback) { //callback (err, ctSubscribed)"/>
					<outline text="">
						<outline text="/*  One feed at a time, in the order the list gives them. A feed">
							<outline text="another followed list already carries needs nothing. A feed the"/>
							<outline text="user already subscribes to personally is remembered as personal,"/>
							<outline text="so the list never owns it. Everything else gets subscribed.  */"/>
							</outline>
						<outline text=""/>
						<outline text="var ctSubscribed = 0;"/>
						<outline text="function doNextFeed (ix) {">
							<outline text="if (ix &lt; theFeeds.length) {">
								<outline text="const theFeed = theFeeds [ix];"/>
								<outline text="if (ctOtherProviders (theFeed.feedUrl, opmlUrl) &gt; 0) {">
									<outline text="doNextFeed (ix + 1);"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="options.isSubscribed (theFeed.feedUrl, function (flSubscribed) {">
										<outline text="if (flSubscribed) {">
											<outline text="theState.personalFeeds [theFeed.feedUrl] = true;"/>
											<outline text="doNextFeed (ix + 1);"/>
											<outline text="}"/>
											</outline>
										<outline text="else {">
											<outline text="const listInfo = {">
												<outline text="listUrl: opmlUrl,"/>
												<outline text="text: theFeed.text,"/>
												<outline text="htmlUrl: theFeed.htmlUrl,"/>
												<outline text="categories: theFeed.categories"/>
												<outline text="};"/>
												</outline>
											<outline text="options.subscribe (theFeed.feedUrl, listInfo, function (err) {">
												<outline text="if (err === undefined) {">
													<outline text="ctSubscribed++;"/>
													<outline text="}"/>
													</outline>
												<outline text="doNextFeed (ix + 1); //one feed failing doesn't stop the list"/>
												<outline text="});"/>
												</outline>
											<outline text="}"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="callback (undefined, ctSubscribed);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="doNextFeed (0);"/>
						<outline text="}"/>
						</outline>
					<outline text="function unsubscribeOnBehalfOfList (theFeedUrls, opmlUrl, callback) { //callback (err, ctUnsubscribed)"/>
					<outline text="">
						<outline text="/*  The provenance rule lives here: a feed survives if another">
							<outline text="followed list still carries it, or if it was the user's own"/>
							<outline text="before any list brought it around.  */"/>
							</outline>
						<outline text=""/>
						<outline text="var ctUnsubscribed = 0;"/>
						<outline text="function doNextFeed (ix) {">
							<outline text="if (ix &lt; theFeedUrls.length) {">
								<outline text="const theFeedUrl = theFeedUrls [ix];"/>
								<outline text="if (ctOtherProviders (theFeedUrl, opmlUrl) &gt; 0) {">
									<outline text="doNextFeed (ix + 1);"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (theState.personalFeeds [theFeedUrl]) {">
										<outline text="delete theState.personalFeeds [theFeedUrl]; //no list involves it anymore -- it's simply the user's"/>
										<outline text="doNextFeed (ix + 1);"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="options.unsubscribe (theFeedUrl, function (err) {">
											<outline text="if (err === undefined) {">
												<outline text="ctUnsubscribed++;"/>
												<outline text="}"/>
												</outline>
											<outline text="doNextFeed (ix + 1);"/>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="callback (undefined, ctUnsubscribed);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="doNextFeed (0);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="function start (callback) { //read the saved state before anything else runs. callback (err)">
						<outline text="options.loadState (function (err, savedState) {">
							<outline text="if (err) {">
								<outline text="callback (err);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="if (savedState === undefined) {">
									<outline text="theState = {">
										<outline text="lists: {},"/>
										<outline text="personalFeeds: {}"/>
										<outline text="};"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="theState = savedState;"/>
									<outline text="}"/>
									</outline>
								<outline text="callback ();"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function followList (opmlUrl, callback) { //callback (err, listRec)">
						<outline text="if (theState.lists [opmlUrl] !== undefined) { //already following -- nothing to do">
							<outline text="callback (undefined, theState.lists [opmlUrl]);"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="readList (opmlUrl, {}, function (err, theList) {">
								<outline text="if (err) {">
									<outline text="callback (err);"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="subscribeOnBehalfOfList (theList.feeds, opmlUrl, function (err, ctSubscribed) {">
										<outline text="const theFeedUrls = [];"/>
										<outline text="theList.feeds.forEach (function (theFeed) {">
											<outline text="theFeedUrls.push (theFeed.feedUrl);"/>
											<outline text="});"/>
											</outline>
										<outline text="const listRec = {">
											<outline text="opmlUrl,"/>
											<outline text="title: theList.title,"/>
											<outline text="description: theList.description,"/>
											<outline text="feedUrls: theFeedUrls,"/>
											<outline text="whenFollowed: new Date ().toISOString (),"/>
											<outline text="whenChecked: new Date ().toISOString (),"/>
											<outline text="etag: theList.etag,"/>
											<outline text="lastModified: theList.lastModified"/>
											<outline text="};"/>
											</outline>
										<outline text="theState.lists [opmlUrl] = listRec;"/>
										<outline text="saveTheState (function (err) {">
											<outline text="callback (err, listRec);"/>
											<outline text="});"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function unfollowList (opmlUrl, callback) { //callback (err)">
						<outline text="const listRec = theState.lists [opmlUrl];"/>
						<outline text="if (listRec === undefined) {">
							<outline text="const message = &quot;Can't unfollow &quot; + opmlUrl + &quot; because you're not following it.&quot;;"/>
							<outline text="callback ({message});"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="delete theState.lists [opmlUrl]; //out of the state first, so the provenance counts don't see it"/>
							<outline text="unsubscribeOnBehalfOfList (listRec.feedUrls, opmlUrl, function (err, ctUnsubscribed) {">
								<outline text="saveTheState (function (err) {">
									<outline text="callback (err);"/>
									<outline text="});"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function checkList (opmlUrl, callback) { //callback (err, {flUnchanged, adds, removes})">
						<outline text="const listRec = theState.lists [opmlUrl];"/>
						<outline text="if (listRec === undefined) {">
							<outline text="const message = &quot;Can't check &quot; + opmlUrl + &quot; because you're not following it.&quot;;"/>
							<outline text="callback ({message});"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="const condGetInfo = {">
								<outline text="etag: listRec.etag,"/>
								<outline text="lastModified: listRec.lastModified"/>
								<outline text="};"/>
								</outline>
							<outline text="readList (opmlUrl, condGetInfo, function (err, theList) {">
								<outline text="if (err) {">
									<outline text="callback (err); //an unreachable list changes nothing -- can't reach isn't the same as isn't there"/>
									<outline text="}"/>
									</outline>
								<outline text="else {">
									<outline text="if (theList.flNotModified) {">
										<outline text="listRec.whenChecked = new Date ().toISOString ();"/>
										<outline text="saveTheState (function (err) {">
											<outline text="callback (err, {flUnchanged: true, adds: [], removes: []});"/>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="const oldFeedUrls = listRec.feedUrls;"/>
										<outline text="const newFeedUrls = [];"/>
										<outline text="theList.feeds.forEach (function (theFeed) {">
											<outline text="newFeedUrls.push (theFeed.feedUrl);"/>
											<outline text="});"/>
											</outline>
										<outline text=""/>
										<outline text="function isInArray (theValue, theArray) {">
											<outline text="var flFound = false;"/>
											<outline text="theArray.forEach (function (theItem) {">
												<outline text="if (theItem === theValue) {">
													<outline text="flFound = true;"/>
													<outline text="}"/>
													</outline>
												<outline text="});"/>
												</outline>
											<outline text="return (flFound);"/>
											<outline text="}"/>
											</outline>
										<outline text="const addedFeeds = [], removedFeedUrls = [];"/>
										<outline text="theList.feeds.forEach (function (theFeed) {">
											<outline text="if (!isInArray (theFeed.feedUrl, oldFeedUrls)) {">
												<outline text="addedFeeds.push (theFeed);"/>
												<outline text="}"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="oldFeedUrls.forEach (function (theFeedUrl) {">
											<outline text="if (!isInArray (theFeedUrl, newFeedUrls)) {">
												<outline text="removedFeedUrls.push (theFeedUrl);"/>
												<outline text="}"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text=""/>
										<outline text="listRec.feedUrls = newFeedUrls; //the new truth, before the callbacks run"/>
										<outline text="listRec.title = theList.title;"/>
										<outline text="listRec.description = theList.description;"/>
										<outline text="listRec.etag = theList.etag;"/>
										<outline text="listRec.lastModified = theList.lastModified;"/>
										<outline text="listRec.whenChecked = new Date ().toISOString ();"/>
										<outline text=""/>
										<outline text="subscribeOnBehalfOfList (addedFeeds, opmlUrl, function (err, ctSubscribed) {">
											<outline text="unsubscribeOnBehalfOfList (removedFeedUrls, opmlUrl, function (err, ctUnsubscribed) {">
												<outline text="saveTheState (function (err) {">
													<outline text="const addedFeedUrls = [];"/>
													<outline text="addedFeeds.forEach (function (theFeed) {">
														<outline text="addedFeedUrls.push (theFeed.feedUrl);"/>
														<outline text="});"/>
														</outline>
													<outline text="callback (err, {flUnchanged: false, adds: addedFeedUrls, removes: removedFeedUrls});"/>
													<outline text="});"/>
													</outline>
												<outline text="});"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function checkLists (callback) { //every followed list, one at a time. callback (err, reports)">
						<outline text="const theListUrls = Object.keys (theState.lists);"/>
						<outline text="const theReports = [];"/>
						<outline text="function doNextList (ix) {">
							<outline text="if (ix &lt; theListUrls.length) {">
								<outline text="const opmlUrl = theListUrls [ix];"/>
								<outline text="checkList (opmlUrl, function (err, theChanges) {">
									<outline text="if (err) {">
										<outline text="theReports.push ({opmlUrl, error: err.message});"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="theReports.push ({opmlUrl, adds: theChanges.adds, removes: theChanges.removes, flUnchanged: theChanges.flUnchanged});"/>
										<outline text="}"/>
										</outline>
									<outline text="doNextList (ix + 1); //one list failing doesn't stop the others"/>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="callback (undefined, theReports);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="doNextList (0);"/>
						<outline text="}"/>
						</outline>
					<outline text="function getLists (callback) { //callback (err, array of listRecs)">
						<outline text="const theLists = [];"/>
						<outline text="Object.keys (theState.lists).forEach (function (opmlUrl) {">
							<outline text="theLists.push (theState.lists [opmlUrl]);"/>
							<outline text="});"/>
							</outline>
						<outline text="callback (undefined, theLists);"/>
						<outline text="}"/>
						</outline>
					<outline text=""/>
					<outline text="this.start = start;"/>
					<outline text="this.followList = followList;"/>
					<outline text="this.unfollowList = unfollowList;"/>
					<outline text="this.checkList = checkList;"/>
					<outline text="this.checkLists = checkLists;"/>
					<outline text="this.getLists = getLists;"/>
					<outline text="}"/>
					</outline>
				</outline>
			<outline text="test.js">
				<outline text="/*  Tests for readinglist.js. 7/31/26 by CC"/>
				<outline text="">
					<outline text="A little http server plays the role of the web, serving OPML we control"/>
					<outline text="and honoring etags. A fake reader app records every subscribe and"/>
					<outline text="unsubscribe. Then we walk the contract, rule by rule."/>
					<outline text=""/>
					<outline text="Run it: node test.js -- it prints one line per test and a total.  */"/>
					</outline>
				<outline text=""/>
				<outline text="const http = require (&quot;http&quot;);"/>
				<outline text="const readinglist = require (&quot;./readinglist.js&quot;);"/>
				<outline text=""/>
				<outline text="const testPort = 1799;"/>
				<outline text="const urlServer = &quot;http://localhost:&quot; + testPort + &quot;/&quot;;"/>
				<outline text=""/>
				<outline text="var ctTests = 0, ctFailures = 0;"/>
				<outline text="function assert (flCondition, theMessage) {">
					<outline text="ctTests++;"/>
					<outline text="if (flCondition) {">
						<outline text="console.log (&quot;ok -- &quot; + theMessage);"/>
						<outline text="}"/>
						</outline>
					<outline text="else {">
						<outline text="ctFailures++;"/>
						<outline text="console.log (&quot;FAILED -- &quot; + theMessage);"/>
						<outline text="}"/>
						</outline>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="//the pretend web: a table of OPML files, each with a version number that becomes its etag">
					<outline text="const theWebFiles = {};"/>
					<outline text="function setWebFile (theName, opmltext) {">
						<outline text="if (theWebFiles [theName] === undefined) {">
							<outline text="theWebFiles [theName] = {version: 0};"/>
							<outline text="}"/>
							</outline>
						<outline text="theWebFiles [theName].opmltext = opmltext;"/>
						<outline text="theWebFiles [theName].version++;"/>
						<outline text="}"/>
						</outline>
					<outline text="const theServer = http.createServer (function (theRequest, theResponse) {">
						<outline text="const theName = theRequest.url.substring (1);"/>
						<outline text="const theFile = theWebFiles [theName];"/>
						<outline text="if (theFile === undefined) {">
							<outline text="theResponse.writeHead (404, {&quot;Content-Type&quot;: &quot;text/plain&quot;});"/>
							<outline text="theResponse.end (&quot;Not found.&quot;);"/>
							<outline text="}"/>
							</outline>
						<outline text="else {">
							<outline text="const theEtag = &quot;\&quot;v&quot; + theFile.version + &quot;\&quot;&quot;;"/>
							<outline text="if (theRequest.headers [&quot;if-none-match&quot;] === theEtag) {">
								<outline text="theResponse.writeHead (304);"/>
								<outline text="theResponse.end ();"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="theResponse.writeHead (200, {&quot;Content-Type&quot;: &quot;text/xml&quot;, &quot;ETag&quot;: theEtag});"/>
								<outline text="theResponse.end (theFile.opmltext);"/>
								<outline text="}"/>
								</outline>
							<outline text="}"/>
							</outline>
						<outline text="});"/>
						</outline>
					</outline>
				<outline text=""/>
				<outline text="function opmlForFeeds (theTitle, theFeeds) { //build a reading list; a feed can be a string or {feedUrl, category, flComment}">
					<outline text="var itemtext = &quot;&quot;;"/>
					<outline text="theFeeds.forEach (function (theFeed) {">
						<outline text="if (typeof (theFeed) === &quot;string&quot;) {">
							<outline text="theFeed = {feedUrl: theFeed};"/>
							<outline text="}"/>
							</outline>
						<outline text="var atts = &quot;type=\&quot;rss\&quot; text=\&quot;&quot; + theFeed.feedUrl + &quot;\&quot; xmlUrl=\&quot;&quot; + theFeed.feedUrl + &quot;\&quot;&quot;;"/>
						<outline text="if (theFeed.category !== undefined) {">
							<outline text="atts += &quot; category=\&quot;&quot; + theFeed.category + &quot;\&quot;&quot;;"/>
							<outline text="}"/>
							</outline>
						<outline text="if (theFeed.flComment) {">
							<outline text="atts += &quot; isComment=\&quot;true\&quot;&quot;;"/>
							<outline text="}"/>
							</outline>
						<outline text="itemtext += &quot;\t\t&lt;outline &quot; + atts + &quot;/&gt;\n&quot;;"/>
						<outline text="});"/>
						</outline>
					<outline text="var headtext = &quot;&quot;;"/>
					<outline text="if (theTitle !== undefined) {">
						<outline text="headtext = &quot;\t&lt;head&gt;\n\t\t&lt;title&gt;&quot; + theTitle + &quot;&lt;/title&gt;\n\t\t&lt;description&gt;A list for testing.&lt;/description&gt;\n\t\t&lt;/head&gt;\n&quot;;"/>
						<outline text="}"/>
						</outline>
					<outline text="return (&quot;&lt;?xml version=\&quot;1.0\&quot; encoding=\&quot;UTF-8\&quot;?&gt;\n&lt;opml version=\&quot;2.0\&quot;&gt;\n&quot; + headtext + &quot;\t&lt;body&gt;\n&quot; + itemtext + &quot;\t\t&lt;/body&gt;\n\t&lt;/opml&gt;\n&quot;);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="//the pretend reader app">
					<outline text="var theApp; //assigned by newApp"/>
					<outline text="function newApp () {">
						<outline text="theApp = {">
							<outline text="subscriptions: {}, //feedUrl: the listInfo that came with the subscribe call"/>
							<outline text="personalFeeds: {}, //feeds the user subscribed to on their own"/>
							<outline text="log: []"/>
							<outline text="};"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function appCallbacks () {">
						<outline text="return ({">
							<outline text="isSubscribed: function (feedUrl, callback) {">
								<outline text="callback ((theApp.subscriptions [feedUrl] !== undefined) || (theApp.personalFeeds [feedUrl] !== undefined));"/>
								<outline text="},"/>
								</outline>
							<outline text="subscribe: function (feedUrl, listInfo, callback) {">
								<outline text="theApp.subscriptions [feedUrl] = listInfo;"/>
								<outline text="theApp.log.push (&quot;subscribe &quot; + feedUrl);"/>
								<outline text="callback ();"/>
								<outline text="},"/>
								</outline>
							<outline text="unsubscribe: function (feedUrl, callback) {">
								<outline text="delete theApp.subscriptions [feedUrl];"/>
								<outline text="theApp.log.push (&quot;unsubscribe &quot; + feedUrl);"/>
								<outline text="callback ();"/>
								<outline text="},"/>
								</outline>
							<outline text="loadState: function (callback) {">
								<outline text="callback (undefined, theApp.savedState);"/>
								<outline text="},"/>
								</outline>
							<outline text="saveState: function (theState, callback) {">
								<outline text="theApp.savedState = JSON.parse (JSON.stringify (theState)); //what a file or database would hold"/>
								<outline text="callback ();"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="function ctSubscriptions () {">
						<outline text="return (Object.keys (theApp.subscriptions).length);"/>
						<outline text="}"/>
						</outline>
					<outline text="function ctLogLines (theText) { //how many times the app heard exactly this">
						<outline text="var ct = 0;"/>
						<outline text="theApp.log.forEach (function (theLine) {">
							<outline text="if (theLine === theText) {">
								<outline text="ct++;"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="return (ct);"/>
						<outline text="}"/>
						</outline>
					</outline>
				<outline text=""/>
				<outline text="theServer.listen (testPort, function () {">
					<outline text="setWebFile (&quot;listA.opml&quot;, opmlForFeeds (&quot;List A&quot;, [">
						<outline text="{feedUrl: &quot;http://feeds.example/one.xml&quot;, category: &quot;tech&quot;},"/>
						<outline text="&quot;http://feeds.example/two.xml&quot;,"/>
						<outline text="&quot;http://feeds.example/three.xml&quot;,"/>
						<outline text="{feedUrl: &quot;http://feeds.example/hidden.xml&quot;, flComment: true}"/>
						<outline text="]));"/>
						</outline>
					<outline text="setWebFile (&quot;listB.opml&quot;, opmlForFeeds (&quot;List B&quot;, [">
						<outline text="&quot;http://feeds.example/three.xml&quot;,"/>
						<outline text="&quot;http://feeds.example/five.xml&quot;"/>
						<outline text="]));"/>
						</outline>
					<outline text="setWebFile (&quot;headless.opml&quot;, opmlForFeeds (undefined, [">
						<outline text="&quot;http://feeds.example/six.xml&quot;"/>
						<outline text="]));"/>
						</outline>
					<outline text="setWebFile (&quot;broken.opml&quot;, &quot;this is not opml at all &lt;&gt;&lt;&quot;);"/>
					<outline text=""/>
					<outline text="newApp ();"/>
					<outline text="theApp.personalFeeds [&quot;http://feeds.example/two.xml&quot;] = true; //the user's own, from before any list"/>
					<outline text=""/>
					<outline text="const theManager = new readinglist.readingListManager (appCallbacks ());"/>
					<outline text=""/>
					<outline text="theManager.start (function (err) {">
						<outline text="assert (err === undefined, &quot;the manager starts with no saved state&quot;);"/>
						<outline text=""/>
						<outline text="theManager.followList (urlServer + &quot;listA.opml&quot;, function (err, listRec) {">
							<outline text="assert (err === undefined, &quot;following list A works&quot;);"/>
							<outline text="assert (listRec.title === &quot;List A&quot;, &quot;the list's title came from the OPML head&quot;);"/>
							<outline text="assert (listRec.feedUrls.length === 3, &quot;the comment node stayed invisible -- 3 feeds, not 4&quot;);"/>
							<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/one.xml&quot;] !== undefined, &quot;feed one was subscribed&quot;);"/>
							<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/one.xml&quot;].categories === &quot;tech&quot;, &quot;the category rode along with the subscribe call&quot;);"/>
							<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/two.xml&quot;] === undefined, &quot;feed two was NOT subscribed -- the user already had it personally&quot;);"/>
							<outline text="assert (ctSubscriptions () === 2, &quot;exactly two subscribe calls for list A&quot;);"/>
							<outline text=""/>
							<outline text="theManager.followList (urlServer + &quot;listA.opml&quot;, function (err, listRec) {">
								<outline text="assert ((err === undefined) &amp;&amp; (ctSubscriptions () === 2), &quot;following the same list again changes nothing&quot;);"/>
								<outline text=""/>
								<outline text="theManager.followList (urlServer + &quot;listB.opml&quot;, function (err, listRec) {">
									<outline text="assert (err === undefined, &quot;following list B works&quot;);"/>
									<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/five.xml&quot;] !== undefined, &quot;feed five was subscribed&quot;);"/>
									<outline text="assert (ctLogLines (&quot;subscribe http://feeds.example/three.xml&quot;) === 1, &quot;feed three was subscribed once, not twice -- list A already carried it&quot;);"/>
									<outline text=""/>
									<outline text="theManager.checkList (urlServer + &quot;listA.opml&quot;, function (err, theChanges) {">
										<outline text="assert ((err === undefined) &amp;&amp; (theChanges.flUnchanged === true), &quot;an unchanged list answers 304 and nothing happens&quot;);"/>
										<outline text=""/>
										<outline text="//list A changes: drops one, two and three, adds four">
											<outline text="setWebFile (&quot;listA.opml&quot;, opmlForFeeds (&quot;List A&quot;, [">
												<outline text="&quot;http://feeds.example/four.xml&quot;"/>
												<outline text="]));"/>
												</outline>
											</outline>
										<outline text="theManager.checkList (urlServer + &quot;listA.opml&quot;, function (err, theChanges) {">
											<outline text="assert (err === undefined, &quot;checking the changed list works&quot;);"/>
											<outline text="assert ((theChanges.adds.length === 1) &amp;&amp; (theChanges.adds [0] === &quot;http://feeds.example/four.xml&quot;), &quot;the added feed was reported&quot;);"/>
											<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/four.xml&quot;] !== undefined, &quot;the added feed was subscribed&quot;);"/>
											<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/one.xml&quot;] === undefined, &quot;the dropped feed was unsubscribed&quot;);"/>
											<outline text="assert (theApp.personalFeeds [&quot;http://feeds.example/two.xml&quot;] !== undefined, &quot;THE RULE: the user's personal feed survived being dropped from the list&quot;);"/>
											<outline text="assert (ctLogLines (&quot;unsubscribe http://feeds.example/two.xml&quot;) === 0, &quot;no unsubscribe call ever fired for the personal feed&quot;);"/>
											<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/three.xml&quot;] !== undefined, &quot;THE RULE: feed three survived -- list B still carries it&quot;);"/>
											<outline text=""/>
											<outline text="theManager.unfollowList (urlServer + &quot;listB.opml&quot;, function (err) {">
												<outline text="assert (err === undefined, &quot;unfollowing list B works&quot;);"/>
												<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/three.xml&quot;] === undefined, &quot;feed three went when its last list let go&quot;);"/>
												<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/five.xml&quot;] === undefined, &quot;feed five went with list B&quot;);"/>
												<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/four.xml&quot;] !== undefined, &quot;list A's feed stayed&quot;);"/>
												<outline text=""/>
												<outline text="theManager.followList (urlServer + &quot;headless.opml&quot;, function (err, listRec) {">
													<outline text="assert (err === undefined, &quot;a list with no head section still works&quot;);"/>
													<outline text="assert (listRec.title === undefined, &quot;its title is honestly undefined&quot;);"/>
													<outline text=""/>
													<outline text="theManager.followList (urlServer + &quot;broken.opml&quot;, function (err) {">
														<outline text="assert (err !== undefined, &quot;a file that isn't OPML answers with an error, not a crash&quot;);"/>
														<outline text="assert (err.message.indexOf (&quot;Can't&quot;) === 0, &quot;the error message says what couldn't be done&quot;);"/>
														<outline text=""/>
														<outline text="theManager.followList (&quot;http://localhost:1/nothing.opml&quot;, function (err) {">
															<outline text="assert (err !== undefined, &quot;an unreachable address answers with an error&quot;);"/>
															<outline text=""/>
															<outline text="theManager.followList (&quot;not a url at all&quot;, function (err) {">
																<outline text="assert (err !== undefined, &quot;a non-url answers with an error&quot;);"/>
																<outline text=""/>
																<outline text="//a brand new manager instance picks up the saved state, like an app relaunching">
																	<outline text="const secondManager = new readinglist.readingListManager (appCallbacks ());"/>
																	<outline text="secondManager.start (function (err) {">
																		<outline text="secondManager.getLists (function (err, theLists) {">
																			<outline text="assert (theLists.length === 2, &quot;a fresh instance loads the saved state -- still following 2 lists&quot;);"/>
																			<outline text="setWebFile (&quot;listA.opml&quot;, opmlForFeeds (&quot;List A&quot;, [">
																				<outline text="&quot;http://feeds.example/four.xml&quot;,"/>
																				<outline text="&quot;http://feeds.example/seven.xml&quot;"/>
																				<outline text="]));"/>
																				</outline>
																			<outline text="secondManager.checkLists (function (err, theReports) {">
																				<outline text="assert (err === undefined, &quot;checkLists sweeps every followed list&quot;);"/>
																				<outline text="assert (theApp.subscriptions [&quot;http://feeds.example/seven.xml&quot;] !== undefined, &quot;the relaunched app still tracks the list -- new feed subscribed&quot;);"/>
																				<outline text="var theReport;"/>
																				<outline text="theReports.forEach (function (item) {">
																					<outline text="if (item.opmlUrl === urlServer + &quot;listA.opml&quot;) {">
																						<outline text="theReport = item;"/>
																						<outline text="}"/>
																						</outline>
																					<outline text="});"/>
																					</outline>
																				<outline text="assert ((theReport !== undefined) &amp;&amp; (theReport.adds.length === 1), &quot;the sweep reported the change per-list&quot;);"/>
																				<outline text=""/>
																				<outline text="console.log (&quot;\n&quot; + ctTests + &quot; tests, &quot; + (ctTests - ctFailures) + &quot; passed, &quot; + ctFailures + &quot; failed.&quot;);"/>
																				<outline text="theServer.close ();"/>
																				<outline text="process.exit ((ctFailures === 0) ? 0 : 1);"/>
																				<outline text="});"/>
																				</outline>
																			<outline text="});"/>
																			</outline>
																		<outline text="});"/>
																		</outline>
																	</outline>
																<outline text="});"/>
																</outline>
															<outline text="});"/>
															</outline>
														<outline text="});"/>
														</outline>
													<outline text="});"/>
													</outline>
												<outline text="});"/>
												</outline>
											<outline text="});"/>
											</outline>
										<outline text="});"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="});"/>
						</outline>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="demo.js">
				<outline text="const fs = require (&quot;fs&quot;);"/>
				<outline text="const readinglist = require (&quot;./readinglist.js&quot;);"/>
				<outline text=""/>
				<outline text="const pathStateFile = &quot;state.json&quot;;"/>
				<outline text="const opmlUrl = process.argv [2];"/>
				<outline text=""/>
				<outline text="if (opmlUrl === undefined) {">
					<outline text="console.log (&quot;Usage: node demo.js &lt;url-of-reading-list&gt;&quot;);"/>
					<outline text="process.exit (1);"/>
					<outline text="}"/>
					</outline>
				<outline text=""/>
				<outline text="const theManager = new readinglist.readingListManager ({">
					<outline text="isSubscribed: function (feedUrl, callback) {">
						<outline text="callback (false); //this demo has no subscriptions of its own"/>
						<outline text="},"/>
						</outline>
					<outline text="subscribe: function (feedUrl, listInfo, callback) {">
						<outline text="console.log (&quot;subscribe: &quot; + feedUrl + ((listInfo.categories === undefined) ? &quot;&quot; : &quot; (&quot; + listInfo.categories + &quot;)&quot;));"/>
						<outline text="callback ();"/>
						<outline text="},"/>
						</outline>
					<outline text="unsubscribe: function (feedUrl, callback) {">
						<outline text="console.log (&quot;unsubscribe: &quot; + feedUrl);"/>
						<outline text="callback ();"/>
						<outline text="},"/>
						</outline>
					<outline text="loadState: function (callback) {">
						<outline text="fs.readFile (pathStateFile, &quot;utf8&quot;, function (err, filetext) {">
							<outline text="if (err) { //no file yet -- first run">
								<outline text="callback (undefined, undefined);"/>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="var theState;"/>
								<outline text="try {">
									<outline text="theState = JSON.parse (filetext);"/>
									<outline text="}"/>
									</outline>
								<outline text="catch (err) {">
									<outline text="callback ({message: &quot;Can't read the saved state because it isn't valid JSON.&quot;});"/>
									<outline text="return;"/>
									<outline text="}"/>
									</outline>
								<outline text="callback (undefined, theState);"/>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="},"/>
						</outline>
					<outline text="saveState: function (theState, callback) {">
						<outline text="fs.writeFile (pathStateFile, JSON.stringify (theState, undefined, &quot;\t&quot;), function (err) {">
							<outline text="callback (err);"/>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="theManager.start (function (err) {">
					<outline text="if (err) {">
						<outline text="console.log (err.message);"/>
						<outline text="}"/>
						</outline>
					<outline text="else {">
						<outline text="theManager.getLists (function (err, theLists) {">
							<outline text="var flAlreadyFollowing = false;"/>
							<outline text="theLists.forEach (function (listRec) {">
								<outline text="if (listRec.opmlUrl === opmlUrl) {">
									<outline text="flAlreadyFollowing = true;"/>
									<outline text="}"/>
									</outline>
								<outline text="});"/>
								</outline>
							<outline text="if (flAlreadyFollowing) { //second run and later: just check for changes">
								<outline text="theManager.checkList (opmlUrl, function (err, theChanges) {">
									<outline text="if (err) {">
										<outline text="console.log (err.message);"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="if (theChanges.flUnchanged) {">
											<outline text="console.log (&quot;The list hasn't changed since last time.&quot;);"/>
											<outline text="}"/>
											</outline>
										<outline text="else {">
											<outline text="console.log (theChanges.adds.length + &quot; added, &quot; + theChanges.removes.length + &quot; removed.&quot;);"/>
											<outline text="}"/>
											</outline>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="else {">
								<outline text="theManager.followList (opmlUrl, function (err, listRec) {">
									<outline text="if (err) {">
										<outline text="console.log (err.message);"/>
										<outline text="}"/>
										</outline>
									<outline text="else {">
										<outline text="const theTitle = (listRec.title === undefined) ? opmlUrl : listRec.title;"/>
										<outline text="console.log (&quot;\nNow following \&quot;&quot; + theTitle + &quot;\&quot; -- &quot; + listRec.feedUrls.length + &quot; feeds.&quot;);"/>
										<outline text="}"/>
										</outline>
									<outline text="});"/>
									</outline>
								<outline text="}"/>
								</outline>
							<outline text="});"/>
							</outline>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				</outline>
			<outline text="readme.md" created="Sun, 02 Aug 2026 17:05:54 GMT">
				<outline text="# readinglist" created="Sun, 02 Aug 2026 17:05:58 GMT">
					<outline text="A node package that manages OPML reading lists for a feed reader. " created="Sun, 02 Aug 2026 17:09:17 GMT"/>
					</outline>
				<outline text="### What is a reading list?" created="Sun, 02 Aug 2026 17:13:07 GMT">
					<outline text="It's an OPML subscription list that a feed reader app subscribes to. When a new item shows up in the list, the feed reader subscribes to it. When one is removed, the subscription is removed. " created="Sun, 02 Aug 2026 17:13:13 GMT"/>
					</outline>
				<outline text="### The app and this package" created="Sun, 02 Aug 2026 17:13:59 GMT">
					<outline text="If your app uses this package, this is how the two connect." created="Sun, 02 Aug 2026 17:15:35 GMT">
						<outline text="1. The app owns its subscriptions, storage and screens. " created="Sun, 02 Aug 2026 17:16:03 GMT"/>
						<outline text="2. This package owns the lists: it reads a reading list, remembers what the list said last time, diffs, and tells the app what changed through two callbacks." created="Sun, 02 Aug 2026 17:17:08 GMT"/>
						<outline text="3. The rule the package enforces: a feed the user subscribed to personally is never removed because a list dropped it, and a feed two lists both carry survives until the last list lets go." created="Sun, 02 Aug 2026 17:16:26 GMT"/>
						</outline>
					</outline>
				<outline text="### Demo" created="Sun, 02 Aug 2026 17:10:39 GMT">
					<outline text="demo.js is a tiny reader app built on  readinglist.js. " created="Sun, 02 Aug 2026 17:23:03 GMT"/>
					<outline text="It &quot;subscribes&quot; by printing to the console, and keeps its state in state.json in this folder, so you can run it twice and watch the second run find only what changed."/>
					<outline text="This is how you launch it, it requires an OPML file to watch" created="Sun, 02 Aug 2026 17:27:12 GMT"/>
					<outline text="`node demo.js https://feedland.social/opml?screenname=davewiner&amp;catname=blogroll`"/>
					</outline>
				<outline text="### What is test.js" created="Sun, 02 Aug 2026 17:29:39 GMT">
					<outline text="An app we use to be sure that it hasn't broken, we left it in because why not?" created="Sun, 02 Aug 2026 17:29:44 GMT"/>
					</outline>
				</outline>
			<outline text="readmeOrig.md" isComment="true">
				<outline text="# Reading lists in your feed reader"/>
				<outline text=""/>
				<outline text="A reading list is a subscription list that lives at a URL, maintained by its editor, followed by readers. When the editor adds a feed, everyone following the list gets it. When they drop one, it goes away. The list is the subscription -- the feeds come and go on the editor's say-so."/>
				<outline text=""/>
				<outline text="This changes where subscriptions live. Instead of being locked inside one reader's storage, a person's subscriptions can live at an address on the web, and any reader that supports reading lists can follow them. Someone who keeps their list at one place can sit down at a different reader, hand it one URL, and be home."/>
				<outline text=""/>
				<outline text="This page is for people who make feed readers and podcast apps -- a reading list of podcast feeds works exactly the same way. It has three parts: the behavior contract, which you can implement in any language; a reference implementation in node, small enough to read in one sitting; and a test suite that doubles as the contract restated as code."/>
				<outline text=""/>
				<outline text="## What a reading list is"/>
				<outline text=""/>
				<outline text="An OPML file at a URL. Each feed is an `outline` node with `type=&quot;rss&quot;` and the feed's address in `xmlUrl`. Nodes may carry `text` (the feed's name), `htmlUrl` (its website) and `category`. A node with `isComment=&quot;true&quot;` is invisible, along with everything nested under it. The file's `head` section may carry a `title` and `description` for the list itself -- or may be missing entirely, which is still a valid list."/>
				<outline text=""/>
				<outline text="A real one to look at: [Dave Winer's blogroll](https://feedland.social/opml?screenname=davewiner&amp;catname=blogroll), 229 feeds."/>
				<outline text=""/>
				<outline text="## The behavior contract"/>
				<outline text=""/>
				<outline text="If your app does these six things, it supports reading lists. Nothing here depends on node, or on any server of ours."/>
				<outline text=""/>
				<outline text="1. **Follow.** The user gives you the URL of a list. Read it, parse it, and subscribe to each feed it names, the way your app subscribes to anything. Show the user the list's title and description."/>
				<outline text="2. **Remember.** For each followed list, keep a small record: the feed urls from the last read, the list's title and description, when you last checked, and the `ETag` or `Last-Modified` the server sent."/>
				<outline text="3. **Check.** On a timer -- once an hour is plenty -- re-read each followed list, sending `If-None-Match` or `If-Modified-Since` from your record. A `304` means nothing changed and you're done, at almost no cost to the server. Otherwise diff the new feed list against your record: subscribe to the feeds that appeared, unsubscribe from the feeds that left, and update the record. This is the feature -- the list's editor is maintaining your user's subscriptions."/>
				<outline text="4. **Respect what's the user's own.** A feed the user subscribed to personally is never removed because a list dropped it. A feed that two followed lists both carry survives until the last one lets go. To honor this, before subscribing on a list's behalf, ask your own database whether the subscription already exists -- if it does, mark it as the user's own and don't claim it for the list."/>
				<outline text="5. **Unfollow.** When the user unfollows a list, unwind its feeds by the same rule: keep what another list still carries, keep what was the user's own, unsubscribe the rest."/>
				<outline text="6. **Fail quietly.** A list that's unreachable or briefly broken changes nothing -- keep the subscriptions as they are and try again next time. Can't reach isn't the same as isn't there."/>
				<outline text=""/>
				<outline text="## The node reference implementation"/>
				<outline text=""/>
				<outline text="[readinglist.js](readinglist.js) is the contract implemented, with the state-keeping and the rules of items 2 through 6 done for you. You connect it to your app with a handful of callbacks, and it never touches your storage or your network beyond the lists themselves."/>
				<outline text=""/>
				<outline text="```javascript"/>
				<outline text="const readinglist = require (&quot;./readinglist.js&quot;);"/>
				<outline text=""/>
				<outline text="const theManager = new readinglist.readingListManager ({">
					<outline text="isSubscribed: function (feedUrl, callback) {">
						<outline text="callback (myApp.hasSubscription (feedUrl)); //does the app already subscribe?"/>
						<outline text="},"/>
						</outline>
					<outline text="subscribe: function (feedUrl, listInfo, callback) {">
						<outline text="myApp.addSubscription (feedUrl, listInfo.text, listInfo.categories);"/>
						<outline text="callback ();"/>
						<outline text="},"/>
						</outline>
					<outline text="unsubscribe: function (feedUrl, callback) {">
						<outline text="myApp.removeSubscription (feedUrl);"/>
						<outline text="callback ();"/>
						<outline text="},"/>
						</outline>
					<outline text="loadState: function (callback) { //hand back what saveState gave you -- undefined the first time">
						<outline text="callback (undefined, myApp.loadJsonFile (&quot;readinglists.json&quot;));"/>
						<outline text="},"/>
						</outline>
					<outline text="saveState: function (theState, callback) {">
						<outline text="myApp.saveJsonFile (&quot;readinglists.json&quot;, theState);"/>
						<outline text="callback ();"/>
						<outline text="}"/>
						</outline>
					<outline text="});"/>
					</outline>
				<outline text=""/>
				<outline text="theManager.start (function (err) {">
					<outline text="theManager.followList (&quot;https://feedland.social/opml?screenname=davewiner&amp;catname=blogroll&quot;, function (err, listRec) {">
						<outline text="console.log (&quot;Following \&quot;&quot; + listRec.title + &quot;\&quot; -- &quot; + listRec.feedUrls.length + &quot; feeds.&quot;);"/>
						<outline text="});"/>
						</outline>
					<outline text="});"/>
					</outline>
				<outline text="```"/>
				<outline text=""/>
				<outline text="Then, on your timer:"/>
				<outline text=""/>
				<outline text="```javascript"/>
				<outline text="theManager.checkLists (function (err, theReports) { //your subscribe/unsubscribe callbacks fire as needed">
					<outline text="});"/>
					</outline>
				<outline text="```"/>
				<outline text=""/>
				<outline text="The full surface: `start`, `followList`, `unfollowList`, `checkList`, `checkLists`, `getLists`. Every callback gets an error object with a `message` when something goes wrong, and never throws."/>
				<outline text=""/>
				<outline text="## The tests"/>
				<outline text=""/>
				<outline text="Run `node test.js`. It starts a little local web server playing the role of the lists, wires up a pretend reader app, and walks the whole contract -- 34 checks, including both halves of the survival rule in item 4. If you're implementing in another language, porting this file is the fastest way to know you got it right."/>
				<outline text=""/>
				<outline text="## Try it"/>
				<outline text=""/>
				<outline text="[demo.js](demo.js) is a five-minute reader: it subscribes by printing. Point it at a real list, then run it again and watch it find nothing to do:"/>
				<outline text=""/>
				<outline text="```"/>
				<outline text="node demo.js &quot;https://feedland.social/opml?screenname=davewiner&amp;catname=blogroll&quot;"/>
				<outline text="```"/>
				<outline text=""/>
				<outline text="## Other languages"/>
				<outline text=""/>
				<outline text="The contract is the spec -- the node code is one rendering of it. If you work in Swift, Rust, Go, C++ or anything else and want this in your language, post an issue on this repo and we'll help, up to and including doing the translation. The point of this page is more apps that follow reading lists, wherever they're written."/>
				</outline>
			</outline>
		<outline text="buld script" isComment="true" created="Sun, 02 Aug 2026 17:18:47 GMT">
			<outline text="nodeEditorSuite.utilities.buildReadinglist ()" created="Sun, 02 Aug 2026 17:18:51 GMT"/>
			</outline>
		</body>
	</opml>
